PUSH Local_Addressbook_Select
{
	iTemp = getlastmodifiedarrayindex();
	if(LocalEntryValid[iTemp] = 1)
	{
		iTemp = (iTemp - 1) + ((iCurrentLocalPage - 1) * EntriesPerScreen);
		if(iCurrentLocalLevel = 0)
		{
			if(LocalAddressBook[iTemp].sType = "group")
			{
				fAddToLocalReturnStack(iCurrentLocalLevel, iCurrentLocalPage);
				iCurrentLocalLevel = LocalAddressBook[iTemp].iGroupPointer;
				iCurrentLocalPage = 1;
				if((Local_Groups[iCurrentLocalLevel].iNumberOfEntries mod EntriesPerScreen) = 0)
				{
					iLocalAddrTotalPages = Local_Groups[iCurrentLocalLevel].iNumberOfEntries / EntriesPerScreen;
				}
				else
				{
					iLocalAddrTotalPages = (Local_Groups[iCurrentLocalLevel].iNumberOfEntries / EntriesPerScreen) + 1;
				}
				Local_Addressbook_CurrentPage = iCurrentLocalPage;
				Local_Addressbook_TotalPages = iLocalAddrTotalPages;
				Local_Addressbook_List_Name_Text = Local_Groups[iCurrentLocalLevel].sName;
				for(a = 1 to 25)
				{
					Local_Addressbook_Name$[a] = "";
					Local_Addressbook_Number$[a] = "";
					LocalEntryValid[a] = 0;
				}
				for(a = 1 to EntriesPerScreen)
				{
					if(a <= Local_Groups[iCurrentLocalLevel].iNumberOfEntries)
					{
						b =  (a - 1) + ((iCurrentLocalPage - 1) * EntriesPerScreen);
						if(LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[b]].sType = "group")
						{
							Local_Addressbook_Name$[a] = csGROUPPREFIX + LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[b]].sName;
						}
						else
						{
							Local_Addressbook_Name$[a] = LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[b]].sName;
						}
						LocalEntryValid[a] = 1;
					}
					else
					{
						break;
					}
				}
			}
			else
			{
				Local_Addressbook_NameSelected$ = LocalAddressBook[iTemp].sName;
				Local_Addressbook_NumberSelected$ = "";
				Local_Addressbook_SpeedSelected$ = "";
				makestring(sTempLocalDialString, "dial addressbook \x22%s\x22\n", LocalAddressBook[iTemp].sName);
			}
		}
		else if((iCurrentLocalLevel > 0) && (iCurrentLocalLevel <= iAddrNumGroups))
		{
			if(LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[iTemp]].sType = "group")
			{
				fAddToLocalReturnStack(iCurrentLocalLevel, iCurrentLocalPage);
				iCurrentLocalLevel = LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[iTemp]].iGroupPointer;
				iCurrentLocalPage = 1;
				if((Local_Groups[iCurrentLocalLevel].iNumberOfEntries mod EntriesPerScreen) = 0)
				{
					iLocalAddrTotalPages = Local_Groups[iCurrentLocalLevel].iNumberOfEntries / EntriesPerScreen;
				}
				else
				{
					iLocalAddrTotalPages = (Local_Groups[iCurrentLocalLevel].iNumberOfEntries / EntriesPerScreen) + 1;
				}
				Local_Addressbook_CurrentPage = iCurrentLocalPage;
				Local_Addressbook_TotalPages = iLocalAddrTotalPages;
				Local_Addressbook_List_Name_Text = Local_Groups[iCurrentLocalLevel].sName;
				for(a = 1 to 25)
				{
					Local_Addressbook_Name$[a] = "";
					Local_Addressbook_Number$[a] = "";
					LocalEntryValid[a] = 0;
				}
				for(a = 1 to EntriesPerScreen)
				{
					if(a <= Local_Groups[iCurrentLocalLevel].iNumberOfEntries)
					{
						b =  (a - 1) + ((iCurrentLocalPage - 1) * EntriesPerScreen);
						if(LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[b]].sType = "group")
						{
							Local_Addressbook_Name$[a] = csGROUPPREFIX + LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[b]].sName;
						}
