/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT Enable;
ANALOG_INPUT XT_Mod_DebugLevel;//			Debug output level 0=no messages 99=all messages 
// ft 02/11/2015 ANALOG_INPUT XT_ACK_WAITING; 
STRING_INPUT Process_C_strings$[100]; 

ANALOG_OUTPUT XT_TE_Network;//			1=SIP	5=IP	6=MCU	7=ISDN						0=Undefined
ANALOG_OUTPUT XT_TE_CallStatus;//  0 = Undefined    
//  2 = idle         
//  5 = first call started
//  6 = first setup sent to network
//  7 = the remote system is ringing after the first call
//  8 = first incoming call
//  9 = first call connected
// 10 = a following call is started
// 11 = a following setup has been sent to network
// 12 = the remote system is ringing after a following call
// 13 = following incoming call
// 14 = following call connected
// 20 = waiting the complete disconnection
// 31 = MCU IP active
ANALOG_OUTPUT XT_TE_VideoRXon;//			0=VideoRX OFF			   1=VideoRX ON						2=Undefined
ANALOG_OUTPUT XT_TE_DataRXon;//				0=DataRX OFF			   1=DataRX ON						2=Undefined
ANALOG_OUTPUT XT_TE_AudioCoding;//			0=Audio OFF 				1..35 Audio Coding 				222=undefined
ANALOG_OUTPUT XT_TE_VideoCoding;//			0=Video OFF 				1..58 Video Coding 				222=undefined
ANALOG_OUTPUT XT_TE_DV_Status;//			0=Dual Video OFF			1=Dual Video ON					2=Undefined
ANALOG_OUTPUT XT_TE_DV_Input;//				0=Undefined			   		8=DVI

// ft 02/11/2015 ANALOG_OUTPUT XT_DATA_ACK;//0=IDLE  1=OK (ACK_WAIT value match)  2=OutOfPhase 3=Error
 
STRING_OUTPUT XT_TE_Number$;//Connected call number
STRING_OUTPUT XT_Test_ExtraDebug_Info$;//Connected call number
