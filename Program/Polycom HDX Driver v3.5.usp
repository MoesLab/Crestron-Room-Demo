				Local_Addressbook_NumberSelected$ = "";
				Local_Addressbook_SpeedSelected$ = "";
				makestring(sTempLocalDialString, "dial addressbook \x22%s\x22\n", LocalAddressBook[Local_Groups[iCurrentLocalLevel].iEntryPointer[iTemp]].sName);
