Function InitializeVars()
{
 	
 	
 	
 	LastWaitingFor=0; 
 	
 	LastCall.Connected=2;//Undefined
    Last_stat_Live=2;//Undefined
    Last_stat_Read=0;//Undefined
    
    LastCall.CallId=0;
	LastCall.MCUCallId=0;
    
	LastACKkind=0;
	NextACKkind=0;
    // ft 02/11/2015 XT_DATA_ACK=0;

	XT_TE_Mute_Status=2;//undefined
	XT_TE_Privacy_Status=2;//undefined
	XT_TE_SelfV_Status=2;//undefined
	XT_TE_DnD_Status=2;//undefined
	XT_TE_REC_Stat=0;
	XT_TE_REC_Available=2;//undefined
	XT_TE_MMpresentation_TX_Status=2;//undefined
	XT_TE_MMpresentation_RX_Status=2;//undefined
	XT_TE_Local_Presentation_Status=2;//undefined
	XT_TE_Live_Call_Status=0;//Disc.
	
	XT_TE_Conf_Control_NL_upd_Req=0;
	XT_TE_Conf_Control_CB_upd_Req=0;
	
	XT_TE_Video_Layout=0;//undefined
	XT_TE_Multi_Image=10;//undefined
	XT_TE_Local_Video_Input=0;//undefined
	XT_TE_ScrSav_Status=2;//undefined
	//XT_TE_Volume=;//undefined
	XT_TE_VideoRX_Status=2;//undefined

	XT_TE_Display$="DISCONNECTED";
	XT_TE_REC_Display$=" "; 
	XT_Test_ExtraDebug_Info$="";
}

