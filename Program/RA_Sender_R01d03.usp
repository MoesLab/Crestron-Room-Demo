STRUCTURE BufferVars
{
	Integer Stat;
	Integer RD;
	Integer WR;
	//String BuffC[MAX_TX_BUFF][MAX_TXCHR];
	Integer CmdID[MAX_TX_BUFF];
	Integer Done[MAX_TX_BUFF];//1=inviato  0=non inviato o in attesa di risposta
	Integer Prio[MAX_TX_BUFF];//0=low prio 1=High Prio
};

BufferVars B;


/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
STRING RefName[60];
String BuffC[MAX_TX_BUFF][MAX_TX_CHR];
STRING GlobalTmpStringHi[MAX_TX_CHR];
STRING GlobalTmpStringLo[MAX_TX_CHR];
INTEGER LastRegStatus;
INTEGER MaxResend,ResendCount;
INTEGER LmsgHi;
INTEGER LmsgLo;
INTEGER GlobalCmdTypeHi;
INTEGER GlobalCmdTypeLo;
INTEGER var_RTS;
INTEGER SECURE_count;
//STRING Outgoing_Cmd[MAX_TX_CHR];
//INTEGER Outgoing_Head;
