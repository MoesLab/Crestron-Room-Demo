/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH update
{
	currHour = gethournum();
	currMinute = getminutesnum();
	currMonth = getmonthnum();
	currDay = getdatenum();
	currYear = getyearnum() - 2000;
	switch( getDayOfWeekNum() ) {
		case( 0 ) : currDayOfWeek = "Sunday";
		case( 1 ) : currDayOfWeek = "Monday";
		case( 2 ) : currDayOfWeek = "Tuesday";
		case( 3 ) : currDayOfWeek = "Wednesday";
		case( 4 ) : currDayOfWeek = "Thursday";
		case( 5 ) : currDayOfWeek = "Friday";
		case( 6 ) : currDayOfWeek = "Saturday";
	}
}


