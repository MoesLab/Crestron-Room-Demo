Function fGetAddressBookTimeOut()
{
	wait(1000, wGetAddressBookTimeOut)
	{
		iAddressBookRequestBusy = 0;
		Get_Addressbooks_Busy = iAddressBookRequestBusy;
	}
}

Function fAddToLocalReturnStack(INTEGER fiLevel, INTEGER fiPage)
{
	if(fiLevel > 0)
	{
		for(a = 5 to 2 step -1)
		{
			iLocalReturnStack[a][1] = iLocalReturnStack[a - 1][1];
			iLocalReturnStack[a][2] = iLocalReturnStack[a - 1][2];
		}
		iLocalReturnStack[1][1] = fiLevel;
		iLocalReturnStack[1][2] = fiPage;
	}
	else if(fiLevel = 0)
	{
		iLocalReturnStack[0][1] = fiLevel;
		iLocalReturnStack[0][2] = fiPage;
	}
}

Integer_Function fRemoveFromLocalReturnStack()
{
	INTEGER fiLevel, fiPage, fiStackEmpty, fiReturnValue;
	
	fiStackEmpty = 1;
	for(a = 1 to 5)
	{
		if((iLocalReturnStack[a][1] <> 0) || (iLocalReturnStack[a][2] <> 0))
		{
			fiStackEmpty = 0;
			break;
		}
	}
	if(fiStackEmpty = 0)
	{
		fiLevel = iLocalReturnStack[1][1];
		fiPage = iLocalReturnStack[1][2];
		for(a = 1 to 4)
		{
			iLocalReturnStack[a][1] = iLocalReturnStack[a + 1][1];
			iLocalReturnStack[a][2] = iLocalReturnStack[a + 1][2];
		}
		iLocalReturnStack[5][1] = 0;
		iLocalReturnStack[5][2] = 0;
	}
	else
	{
		fiLevel = iLocalReturnStack[0][1];
		fiPage = iLocalReturnStack[0][2];
	}
	fiReturnValue = (fiLevel * 100) + fiPage;
	return(fiReturnValue);
}

Function fAddToGlobalReturnStack(INTEGER fiLevel, INTEGER fiPage)
{
	if(fiLevel > 0)
	{
		for(a = 5 to 2 step -1)
		{
			iGlobalReturnStack[a][1] = iGlobalReturnStack[a - 1][1];
			iGlobalReturnStack[a][2] = iGlobalReturnStack[a - 1][2];
		}
		iGlobalReturnStack[1][1] = fiLevel;
		iGlobalReturnStack[1][2] = fiPage;
	}
	else if(fiLevel = 0)
	{
		iGlobalReturnStack[0][1] = fiLevel;
		iGlobalReturnStack[0][2] = fiPage;
	}
}

Integer_Function fRemoveFromGlobalReturnStack()
{
	INTEGER fiLevel, fiPage, fiStackEmpty, fiReturnValue;
	
	fiStackEmpty = 1;
	for(a = 1 to 5)
	{
		if((iGlobalReturnStack[a][1] <> 0) || (iGlobalReturnStack[a][2] <> 0))
		{
			fiStackEmpty = 0;
			break;
		}
	}
	if(fiStackEmpty = 0)
	{
		fiLevel = iGlobalReturnStack[1][1];
		fiPage = iGlobalReturnStack[1][2];
		for(a = 1 to 4)
		{
			iGlobalReturnStack[a][1] = iGlobalReturnStack[a + 1][1];
			iGlobalReturnStack[a][2] = iGlobalReturnStack[a + 1][2];
		}
		iGlobalReturnStack[5][1] = 0;
		iGlobalReturnStack[5][2] = 0;
	}
	else
	{
		fiLevel = iGlobalReturnStack[0][1];
		fiPage = iGlobalReturnStack[0][2];
	}
	fiReturnValue = (fiLevel * 100) + fiPage;
	return(fiReturnValue);
}

Function fAudioCallEndedTimeOut()
{
	wait(1000)
	{
		sAudioStatus = "";
		Audio_Call_Status_Text = sAudioStatus;
	}
}

Function fLocalAddressbookRequestTimeOut()
{
	wait(1000, wLocalRequest)
	{
		iAddrbkBusy = 0;
		Local_Addressbook_Busy = iAddrbkBusy;
	}
}

Function fGlobalAddressbookRequestTimeOut()
{
	wait(1000, wGlobalRequest)
	{
		iGAddrbkBusy = 0;
		Global_Addressbook_Busy = iGAddrbkBusy;
	}
}

Function fVideoCallEndedTimeOut(INTEGER fiCall)
{
	
	switch(fiCall)
	{
		case(1):
		{
			wait(1000, wVideoCall1)
			{
				sVideoStatus[1] = "";
				Video_Call_Status_Text[1] = sVideoStatus[1];
			}
		}
		case(2):
		{
			wait(1000, wVideoCall2)
			{
				sVideoStatus[2] = "";
				Video_Call_Status_Text[2] = sVideoStatus[2];
			}
		}
		case(3):
		{
			wait(1000, wVideoCall3)
			{
				sVideoStatus[3] = "";
				Video_Call_Status_Text[3] = sVideoStatus[3];
			}
		}
		case(4):
		{
			wait(1000, wVideoCall4)
			{
				sVideoStatus[4] = "";
				Video_Call_Status_Text[4] = sVideoStatus[4];
			}
		}
	}
}

function fProcessNotification(STRING fsCallType)
{
	if(sTempCallType = "voiceonly")
	{
		if(iTempCallID = iAudioCallID)
		{
			if(sAudioFEName <> sTempFEName)
			{
				sAudioFEName = sTempFEName;
				Audio_Caller_ID_Name_Text = sAudioFEName;
			}
			if(sAudioFENumber <> sTempFENumber)
			{
				sAudioFENumber = sTempFENumber;
				Audio_Caller_ID_Phone_Number_Text = sAudioFENumber;
			}
			if(sAudioStatus <> sTempStatus)
			{
				sAudioStatus = sTempStatus;
				Audio_Call_Status_Text = sAudioStatus;
			}
			if((sTempDirection = "incoming") && (sTempStatus = "ringing"))
			{
				Incoming_Audio_Call = 1;
				iAudioHookState = 1;
				Audio_Hook_State = iAudioHookState;
			}
			else if(sTempStatus = "opened")
			{
				Incoming_Audio_Call = 0;
				iAudioHookState = 1;
				Audio_Hook_State = iAudioHookState;
			}
			else if(sTempStatus = "connecting")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "connected")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "disconnecting")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "disconnected")
			{
				Incoming_Audio_Call = 0;
				iAudioHookState = 0;
				Audio_Hook_State = iAudioHookState;
				Audio_Call_Active = 0;
				iAudioCallID = 0;
				sAudioFEName = "";
				Audio_Caller_ID_Name_Text = sAudioFEName;
				sAudioFENumber = "";
				Audio_Caller_ID_Phone_Number_Text = sAudioFENumber;
				fAudioCallEndedTimeOut();
			}
		}
		else if(iAudioCallID = 0)
		{
			iAudioCallID = iTempCallID;
			if(sAudioFEName <> sTempFEName)
			{
				sAudioFEName = sTempFEName;
				Audio_Caller_ID_Name_Text = sAudioFEName;
			}
			if(sAudioFENumber <> sTempFENumber)
			{
				sAudioFENumber = sTempFENumber;
				Audio_Caller_ID_Phone_Number_Text = sAudioFENumber;
			}
			if(sAudioStatus <> sTempStatus)
			{
				sAudioStatus = sTempStatus;
				Audio_Call_Status_Text = sAudioStatus;
			}
			if((sTempDirection = "incoming") && (sTempStatus = "ringing"))
			{
				Incoming_Audio_Call = 1;
				iAudioHookState = 1;
				Audio_Hook_State = iAudioHookState;
			}
			else if(sTempStatus = "opened")
			{
				Incoming_Audio_Call = 0;
				iAudioHookState = 1;
				Audio_Hook_State = iAudioHookState;
			}
			else if(sTempStatus = "connecting")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "connected")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "disconnecting")
			{
				Incoming_Audio_Call = 0;
				Audio_Call_Active = 1;
			}
			else if(sTempStatus = "disconnected")
			{
				Incoming_Audio_Call = 0;
				iAudioHookState = 0;
				Audio_Hook_State = iAudioHookState;
				Audio_Call_Active = 0;
				iAudioCallID = 0;
				sAudioFEName = "";
				Audio_Caller_ID_Name_Text = sAudioFEName;
				sAudioFENumber = "";
				Audio_Caller_ID_Phone_Number_Text = sAudioFENumber;
				fAudioCallEndedTimeOut();
			}
		}
		sTempDirection = "";
		sTempFEName = "";
		sTempFENumber = "";
		sTempStatus = "";
		sTempCallType = "";
	}
	else//VIDEO CALL **There could be up to four video calls at the same time.**
	{
		iVideoCall = 0;
		for(a = 1 to 4)
		{
			if(iTempCallID = iVideoCallID[a])
			{
				iVideoCall = a;
				break;
			}
		}
		if(iVideoCall = 0)
		{
			for(a = 1 to 4)
			{
				if(iVideoCallID[a] = 0)
				{
					iVideoCall = a;
					iVideoCallID[a] = iTempCallID;
					break;
				}
			}
		}
		if(iVideoCall > 0)
		{
			if((sTempDirection = "incoming") && (sTempStatus = "ringing"))
			{
				Incoming_Video_Call = 1;
				iIncomingVideoCallID = iTempCallID;
				Incoming_Video_Caller_ID_Name_Text = sTempFEName;
				Incoming_Video_Caller_ID_Phone_Number_Text = sTempFENumber;
				Incoming_Video_Call_Status_Text = sTempStatus;
			}
			else if(sTempStatus = "opened")
			{
				Incoming_Video_Call = 0;
				iIncomingVideoCallID = 0;
				Incoming_Video_Caller_ID_Name_Text = "";
				Incoming_Video_Caller_ID_Phone_Number_Text = "";
				Incoming_Video_Call_Status_Text = "";
				if(sVideoFEName[iVideoCall] <> sTempFEName)
				{
					sVideoFEName[iVideoCall] = sTempFEName;
					Video_Caller_ID_Name_Text[iVideoCall] = sVideoFEName[iVideoCall];
				}
				if(sVideoFENumber[iVideoCall] <> sTempFENumber)
				{
					sVideoFENumber[iVideoCall] = sTempFENumber;
					Video_Caller_ID_Phone_Number_Text[iVideoCall] = sVideoFENumber[iVideoCall];
				}
				if(sVideoStatus[iVideoCall] <> sTempStatus)
				{
					sVideoStatus[iVideoCall] = sTempStatus;
					Video_Call_Status_Text[iVideoCall] = sVideoStatus[iVideoCall];
				}
			}
			else if(sTempStatus = "connecting")
			{
				Incoming_Video_Call = 0;
				iIncomingVideoCallID = 0;
				Incoming_Video_Caller_ID_Name_Text = "";
				Incoming_Video_Caller_ID_Phone_Number_Text = "";
				Incoming_Video_Call_Status_Text = "";
				if(sVideoFEName[iVideoCall] <> sTempFEName)
				{
					sVideoFEName[iVideoCall] = sTempFEName;
					Video_Caller_ID_Name_Text[iVideoCall] = sVideoFEName[iVideoCall];
				}
				if(sVideoFENumber[iVideoCall] <> sTempFENumber)
				{
					sVideoFENumber[iVideoCall] = sTempFENumber;
					Video_Caller_ID_Phone_Number_Text[iVideoCall] = sVideoFENumber[iVideoCall];
				}
				if(sVideoStatus[iVideoCall] <> sTempStatus)
				{
					sVideoStatus[iVideoCall] = sTempStatus;
					Video_Call_Status_Text[iVideoCall] = sVideoStatus[iVideoCall];
				}
			}
			else if(sTempStatus = "connected")
			{
				Incoming_Video_Call = 0;
				iIncomingVideoCallID = 0;
				Incoming_Video_Caller_ID_Name_Text = "";
				Incoming_Video_Caller_ID_Phone_Number_Text = "";
				Incoming_Video_Call_Status_Text = "";
				if(sVideoFEName[iVideoCall] <> sTempFEName)
				{
					sVideoFEName[iVideoCall] = sTempFEName;
					Video_Caller_ID_Name_Text[iVideoCall] = sVideoFEName[iVideoCall];
				}
				if(sVideoFENumber[iVideoCall] <> sTempFENumber)
				{
					sVideoFENumber[iVideoCall] = sTempFENumber;
					Video_Caller_ID_Phone_Number_Text[iVideoCall] = sVideoFENumber[iVideoCall];
				}
				if(sVideoStatus[iVideoCall] <> sTempStatus)
				{
					sVideoStatus[iVideoCall] = sTempStatus;
					Video_Call_Status_Text[iVideoCall] = sVideoStatus[iVideoCall];
				}
			}
			else if(sTempStatus = "disconnecting")
			{
				Incoming_Video_Call = 0;
				iIncomingVideoCallID = 0;
				Incoming_Video_Caller_ID_Name_Text = "";
				Incoming_Video_Caller_ID_Phone_Number_Text = "";
				Incoming_Video_Call_Status_Text = "";
				if(sVideoFEName[iVideoCall] <> sTempFEName)
				{
					sVideoFEName[iVideoCall] = sTempFEName;
					Video_Caller_ID_Name_Text[iVideoCall] = sVideoFEName[iVideoCall];
				}
				if(sVideoFENumber[iVideoCall] <> sTempFENumber)
				{
					sVideoFENumber[iVideoCall] = sTempFENumber;
					Video_Caller_ID_Phone_Number_Text[iVideoCall] = sVideoFENumber[iVideoCall];
				}
				if(sVideoStatus[iVideoCall] <> sTempStatus)
				{
					sVideoStatus[iVideoCall] = sTempStatus;
					Video_Call_Status_Text[iVideoCall] = sVideoStatus[iVideoCall];
				}
			}
			else if(sTempStatus = "disconnected")
			{
				Incoming_Video_Call = 0;
				iIncomingVideoCallID = 0;
				Incoming_Video_Caller_ID_Name_Text = "";
				Incoming_Video_Caller_ID_Phone_Number_Text = "";
				Incoming_Video_Call_Status_Text = "";
				iVideoCallID[iVideoCall] = 0;
				sVideoFEName[iVideoCall] = "";
				Video_Caller_ID_Name_Text[iVideoCall] = sVideoFEName[iVideoCall];
				sVideoFENumber[iVideoCall] = "";
				Video_Caller_ID_Phone_Number_Text[iVideoCall] = sVideoFENumber[iVideoCall];
				fVideoCallEndedTimeOut(iVideoCall);
			}
		}
		sTempDirection = "";
		sTempFEName = "";
		sTempFENumber = "";
		sTempStatus = "";
		sTempCallType = "";
	}
}

function fProcessLocalAddressBook()
{
	iMarker1 = 0;
	iMarker2 = 0;
	iMarker3 = 0;
	iMarker4 = 0;
	iMarker5 = 0;
	iMarker6 = 0;
	iMarker7 = 0;
	iMarker8 = 0;
	iMarker1 = find("\x20", Tempstring$);
	iMarker2 = find("\x20", Tempstring$, iMarker1 + 1);
	iMarker3 = find("\x20", Tempstring$, iMarker2 + 1);
	iMarker4 = find("\x20", Tempstring$, iMarker3 + 1);
	iMarker5 = reversefind("\x20", Tempstring$);
	if((iMarker1 <> 0) && (iMarker2 <> 0))
	{
		sTemp1 = mid(Tempstring$, iMarker1 + 1, iMarker2 - iMarker1 - 1);
/*************************************************************************************************
Response samples
        1     2   3    4
addrbook names all size 21
        1     2   3 4
addrbook names all 0 9
        1     2  3         4    5               6
addrbook names 0. name:"Eng RPX" sys_label:"HDX" type:multicodec
        1     2   3 4 5
addrbook names all 0 9 done
        1     2  3         4    5   
addrbook group 0. name:"Eng RPX" sys_label:"HDX"
        1     2       3     4    5
addrbook group "Monday Staff Mtg" done
        1     2    3
addrbook group size 10
        1       2  3          4       5            6       7            8                       9
addrbook address 0. name:"Geno Alissi" sys_label:"" codec:1 h323_spd:384 h323_num:172.25.137.101 h323_ext:
        1       2          3       4            5
addrbook address name:"Geno Alissi" sys_label:"" done
*************************************************************************************************/
		if(sTemp1 = "names")
		{
			if(iMarker3 <> 0)
			{
				sTemp2 = mid(Tempstring$, iMarker2 + 1, iMarker3 - iMarker2 - 1);
//	addrbook names all size 21
//	addrbook names all 0 9
//	addrbook names all 0 9 done
				if(sTemp2 = "all")
				{
					if(iMarker4 <> 0)
					{
						sTemp3 = mid(Tempstring$, iMarker3 + 1, iMarker4 - iMarker3 - 1);
						if(sTemp3 = "size")
						{
							iAddrbookSize = atoi(Tempstring$);
							if((iAddrbookSize mod EntriesPerScreen) = 0)
							{
								iLocalAddrTotalPages = iAddrbookSize / EntriesPerScreen;
							}
							else
							{
								iLocalAddrTotalPages = (iAddrbookSize / EntriesPerScreen) + 1;
							}
							if(iAddrbookSize > 0)
							{
								siError = resizestructurearray(LocalAddressBook, iAddrbookSize);
							}
							if(iAddrbookSize > 20)
							{
								iAddrRequestedEntry = 20;
								sTempSend = "addrbook names all 0 19\n";
							}
							else
							{
								sTempSend = "addrbook names all\n";
							}
						}
						else
						{
							if(iMarker5 <> 0)
							{
								sTemp4 = right(Tempstring$, len(Tempstring$) - iMarker5);
								if(sTemp4 = "done")
								{
									if(iAddrRequestedEntry < iAddrbookSize)
									{
										makestring(sTempSend, "addrbook names all %d %d\n", iAddrRequestedEntry, (iAddrRequestedEntry - 1) + 20);
										iAddrRequestedEntry = iAddrRequestedEntry + 20;
									}
									else if(iAddrNumGroups > 0)
									{
										iRequestGroup = 1;
										makestring(sTempSend, "addrbook group \x22%s\x22\n", Local_Groups[iRequestGroup].sName);
									}
									else if(iEnableGLobal = 1)
									{
										if((!GDS_Available) && (LDAP_Available))
										{
											iEntryCounter = 0;
											nextSearchChar = 0;
											makestring(ToDevice$, "gaddrbook names search \x22%s\x22 size\n", sCharacterArray[nextSearchChar]);
										}
										else if(GDS_Available)
										{
											iTempGlobalBatch = 1;
											ToDevice$ = "gaddrbook batch 0\n";
										}
									}
									else
									{
										iAddressBookRequestBusy = 0;
										Get_Addressbooks_Busy = iAddressBookRequestBusy;
									}
								}
							}
						}
					}
				}
//	addrbook names 0. name:"Eng RPX" sys_label:"HDX" type:multicodec
				else if((len(sTemp2) >= 2) && (byte(sTemp2, len(sTemp2)) = 0x2E))
				{
					iTempEntryNum = atoi(sTemp2);
					iMarker6 = find("name:", Tempstring$);
					iMarker7 = find("\x22", Tempstring$, iMarker6); //Find the " character
					iMarker8 = find("\x22", Tempstring$, iMarker7 + 1); //Find the next " character
					sTempName = mid(Tempstring$, iMarker7 + 1, iMarker8 - iMarker7 - 1);
					iMarker6 = find("type:", Tempstring$);
					sTempType = right(Tempstring$, len(Tempstring$) - (iMarker6 + len("type:") - 1));
					if(sTempType = "group")
					{
						iAddrNumGroups = iAddrNumGroups + 1;
						if(iAddrNumGroups > iAddrGroupSize)
						{
							iAddrGroupSize = iAddrNumGroups;
							siError = resizestructurearray(Local_Groups, iAddrGroupSize);
						}
						Local_Groups[iAddrNumGroups].sName = sTempName;
						LocalAddressBook[iTempEntryNum].iGroupPointer = iAddrNumGroups;
					}
					else
					{
						LocalAddressBook[iTempEntryNum].iGroupPointer = 0;
					}
					LocalAddressBook[iTempEntryNum].sName = sTempName;
					LocalAddressBook[iTempEntryNum].sType = sTempType;
				}
			}
		}
//	addrbook group 0. name:"Eng RPX" sys_label:"HDX"
//	addrbook group "Monday Staff Mtg" done
//	addrbook group size 10
		else if(sTemp1 = "group")
		{
			if(iMarker3 <> 0)
			{
				sTemp2 = mid(Tempstring$, iMarker2 + 1, iMarker3 - iMarker2 - 1);
				if((len(sTemp2) >= 2) && (byte(sTemp2, len(sTemp2)) = 0x2E))
				{
					iTempEntryNum = atoi(sTemp2);
					iMarker6 = find("name:", Tempstring$);
					iMarker7 = find("\x22", Tempstring$, iMarker6); //Find the " character
					iMarker8 = find("\x22", Tempstring$, iMarker7 + 1); //Find the next " character
					sTempName = mid(Tempstring$, iMarker7 + 1, iMarker8 - iMarker7 - 1);
					for(a = 1 to iAddrbookSize)
					{
						if(sTempName = LocalAddressBook[a].sName)
						{
							Local_Groups[iRequestGroup].iEntryPointer[iTempEntryNum] = a;
							break;
						}
					}
				}
				else if(byte(sTemp2, 1) = 0x22)
				{
					if(iMarker5 <> 0)
					{
						sTemp4 = right(Tempstring$, len(Tempstring$) - iMarker5);
						if(sTemp4 = "done")
						{
							Local_Groups[iRequestGroup].iNumberOfEntries = iTempEntryNum + 1;
							iRequestGroup = iRequestGroup + 1;
							if(iRequestGRoup <= iAddrNumGroups)
							{
								makestring(sTempSend, "addrbook group \x22%s\x22\n", Local_Groups[iRequestGroup].sName);
							}
							else if(iEnableGlobal = 1)
							{
								if((!GDS_Available) && (LDAP_Available))
								{
									iEntryCounter = 0;
									nextSearchChar = 0;
									makestring(ToDevice$, "gaddrbook names search \x22%s\x22 size\n", sCharacterArray[nextSearchChar]);
								}
								else if(GDS_Available)
								{
									iTempGlobalBatch = 1;
									ToDevice$ = "gaddrbook batch 0\n";
								}
							}
							else
							{
								iAddressBookRequestBusy = 0;
								Get_Addressbooks_Busy = iAddressBookRequestBusy;
							}
						}
					}
				}
			}
		}
	}
}

Function fProcessGroup(string fsTempString$)
{
	integer fiMarker1, fiMarker2, fiMarker3, fiMarker4, fiMarker5, fiMarker6;
	string fsTemp1[ciMAXCHARS], fsTemp2[ciMAXCHARS];
	fiMarker1 = 0;
	fiMarker2 = 0;
	fiMarker3 = 0;
	fiMarker4 = 0;
	fiMarker5 = 0;
	fiMarker6 = 0;
	fiMarker1 = find("\x20", fsTempString$);
	fiMarker2 = find("\x20", fsTempString$, fiMarker1 + 1);
	if((fiMarker1 <> 0) && (fiMarker2 <> 0))
	{
		fsTemp1 = mid(fsTempString$, fiMarker1 + 1, fiMarker2 - fiMarker1 - 1);
		if(fsTemp1 = "grouplist")
		{
			fiMarker3 = find("\x20", fsTempString$, fiMarker2 + 1);
			if(fiMarker3 <> 0)
			{
				fsTemp2 = mid(fsTempString$, fiMarker2 + 1, fiMarker3 - fiMarker2 - 1);
//	gaddrbook grouplist size 6
				if(fsTemp2 = "size")
				{
					iGAddrGroupSize = atoi(fsTempString$);
					if(iGAddrGroupSize > ciDEFAULTGROUPS)
					{
						siError = resizestructurearray(Global_Groups, iGAddrGroupSize);
					}
					if(iGAddrGroupSize >= 20)
					{
						iGAddrGroupRequestedEntry = 20;
						sTempSend = "gaddrbook grouplist 0 19\n";
					}
					else if(iGAddrGroupSize > 0)
					{
						iGAddrGroupRequestedEntry = iGAddrGroupSize;
						makestring(sTempSend, "gaddrbook grouplist 0 %d\n", iGAddrGroupSize - 1);
					}
					else
					{
						iAddressBookRequestBusy = 0;
						Get_Addressbooks_Busy = iAddressBookRequestBusy;
					}
				}
//	gaddrbook grouplist 3. group:"SW Group"
				else if((len(fsTemp2) >= 2) && (byte(fsTemp2, len(fsTemp2)) = 0x2E))
				{
					iTempGroupNum = atoi(fsTemp2);
					fiMarker4 = find("group:", fsTempString$);
					fiMarker5 = find("\x22", fsTempString$, fiMarker4);
					fiMarker6 = find("\x22", fsTempString$, fiMarker5 + 1);
					sTempName = mid(Tempstring$, fiMarker5 + 1, fiMarker6 - (fiMarker5 + 1));
					if(iTempGroupNum <= iGAddrGroupSize)
					{
						for(a = 0 to iGAddressbookSize)
						{
							if(GlobalAddressbook[a].sName = sTempName)
							{
								GlobalAddressbook[a].sType = "group";
								GlobalAddressbook[a].iGroupPointer = iTempGroupNum;
								break;
							}
						}
						Global_Groups[iTempGroupNum].sName = sTempName;
					}
				}
//	gaddrbook grouplist 0 3 done
				else
				{
					fiMarker3 = reversefind("\x20", fsTempString$);
					fsTemp2 = mid(fsTempString$, fiMarker3 + 1, len(fsTempString$) - fiMarker2);
					if(fsTemp2 = "done")
					{
						if((iGAddrGroupRequestedEntry + 20) < iGAddrGroupSize)
						{
							makestring(sTempSend, "gaddrbook grouplist %d %d\n", iGAddrGroupRequestedEntry, (iGAddrGroupRequestedEntry - 1) + 20);
							iGAddrGroupRequestedEntry = iGAddrGroupRequestedEntry + 20;
						}
						else if(iGAddrGroupRequestedEntry < iGAddrGroupSize)
						{
							makestring(sTempSend, "gaddrbook grouplist %d %d\n", iGAddrGroupRequestedEntry, iGAddrGroupRequestedEntry + (iGAddrGroupSize - iGAddrGroupRequestedEntry));
							iGAddrGroupRequestedEntry = iGAddrGroupSize;
						}
						else if(iGAddrGroupSize > 0)
						{
							iGlobalGroupRequested = 0;
							makestring(sTempSend, "gaddrbook group \x22%s\x22 size\n", Global_Groups[iGlobalGroupRequested].sName);
						}
						else
						{
							iAddressBookRequestBusy = 0;
							Get_Addressbooks_Busy = iAddressBookRequestBusy;
						}
					}
				}
			}
		}
/*************************************************************************************************
	This section will process the groups from the global address book.

gaddrbook group "Andover ITP" size 5
gaddrbook group "Andover ITP" 0 3 done
*************************************************************************************************/
		else if(fsTemp1 = "group")
		{
			fiMarker3 = reversefind("\x20", fsTempString$);
			fsTemp2 = mid(fsTempString$, fiMarker3 + 1, len(fsTempString$) - fiMarker3);
			if(fsTemp2 = "done")
			{
				if((iGlobalGroupEntriesRequested + 20) < Global_Groups[iGlobalGroupRequested].iNumberOfEntries)
				{
					makestring(sTempSend, "gaddrbook group \x22%s\x22 %d %d\n", Global_Groups[iGlobalGroupRequested].sName, iGlobalGroupEntriesRequested, (iGlobalGroupEntriesRequested - 1) + 20);
					iGlobalGroupEntriesRequested = iGlobalGroupEntriesRequested + 20;
				}
				else if(iGlobalGroupEntriesRequested < Global_Groups[iGlobalGroupRequested].iNumberOfEntries)
				{
					makestring(sTempSend, "gaddrbook group \x22%s\x22 %d %d\n", Global_Groups[iGlobalGroupRequested].sName, iGlobalGroupEntriesRequested, Global_Groups[iGlobalGroupRequested].iNumberOfEntries);
					iGlobalGroupEntriesRequested = Global_Groups[iGlobalGroupRequested].iNumberOfEntries;
				}
				else if(iGlobalGroupEntriesRequested = Global_Groups[iGlobalGroupRequested].iNumberOfEntries)
				{
					if(iGAddrGroupSize > (iGlobalGroupRequested + 1))
					{
						iGlobalGroupRequested = iGlobalGroupRequested + 1;
						makestring(sTempSend, "gaddrbook group \x22%s\x22 size\n", Global_Groups[iGlobalGroupRequested].sName);
					}
					else
					{
						iAddressBookRequestBusy = 0;
						Get_Addressbooks_Busy = iAddressBookRequestBusy;
					}
				}
			}
			else
			{
				Global_Groups[iGlobalGroupRequested].iNumberOfEntries = atoi(fsTemp2);
				if(Global_Groups[iGlobalGroupRequested].iNumberOfEntries > ciDEFAULTGROUPENTRIES)
				{
					siError = resizearray(Global_Groups[iGlobalGroupRequested].iEntryPointer, iTempEntryNum);
				}
				if((Global_Groups[iGlobalGroupRequested].iNumberOfEntries > 0) && (Global_Groups[iGlobalGroupRequested].iNumberOfEntries >= 20))
				{
					iGlobalGroupEntriesRequested = 20;
					makestring(sTempSend, "gaddrbook group \x22%s\x22 0 19\n", Global_Groups[iGlobalGroupRequested].sName);
				}
				else if((Global_Groups[iGlobalGroupRequested].iNumberOfEntries > 0) && (Global_Groups[iGlobalGroupRequested].iNumberOfEntries < 20))
				{
					iGlobalGroupEntriesRequested = Global_Groups[iGlobalGroupRequested].iNumberOfEntries;
					makestring(sTempSend, "gaddrbook group \x22%s\x22 0 %d\n", Global_Groups[iGlobalGroupRequested].sName, Global_Groups[iGlobalGroupRequested].iNumberOfEntries - 1);
				}
			}
		}
	}
}

