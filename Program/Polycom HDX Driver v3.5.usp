				Global_Addressbook_NumberSelected$ = "";
				Global_Addressbook_SpeedSelected$ = "";
				makestring(sTempGlobalDialString, "dial addressbook \x22%s\x22\n", GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[iTemp]].sName);
