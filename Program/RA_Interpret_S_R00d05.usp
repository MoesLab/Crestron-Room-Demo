//--28/07/2015  ANALOG_INPUT XT_ACK_WAITING; 
ANALOG_INPUT XT_UI_Video_Layout_In;
STRING_INPUT Process_S_strings$[100]; 

ANALOG_INPUT _SKIP_,From_C_Mod_Network;//			1=SIP	5=IP	6=MCU	7=ISDN						0=Undefined
ANALOG_INPUT From_C_Mod_CallStat;//CB - 0 = Undefined    
//  2 = idle (Disconnected)        
//  5 = first call started
//  6 = first setup sent to network
//  7 = the remote system is ringing after the first call
//  8 = first incoming call
//  9 = first call connected
// 10 = a following call is started
// 11 = a following setup has been sent to network
// 12 = the remote system is ringing after a following call
// 13 = following incoming call
// 14 = following call connected
// 20 = waiting the complete disconnection
// 31 = MCU IP active
ANALOG_INPUT From_C_Mod_VideoRX;//				0=VideoRX OFF			    1=VideoRX ON					2=Undefined
ANALOG_INPUT From_C_Mod_DataRX;//				0=DataRX OFF			    1=DataRX ON						2=Undefined
ANALOG_INPUT From_C_Mod_AudCoding;//			0=Audio OFF 				1..35 Audio Coding 				222=undefined
ANALOG_INPUT From_C_Mod_VidCoding;//			0=Video OFF 				1..58 Video Coding 				222=undefined
ANALOG_INPUT From_C_Mod_DVstat;//				0=Dual Video OFF			1=Dual Video ON					2=Undefined
ANALOG_INPUT From_C_Mod_DVinp;//				0=Undefined			   		8=DVI

//DIGITAL_OUTPUT XT_Connect_F,TCPIP_CONN_ERR_FB,_SKIP_;
//DIGITAL_OUTPUT XT_DATA_OK_OS;
//DIGITAL_OUTPUT XT_DATA_ACK_OS;
DIGITAL_OUTPUT XT_TE_Conf_Control_NL_upd_Req;//Set module to check for new terminal list ( AT[?SHN & AT[?SHL )
DIGITAL_OUTPUT XT_TE_Conf_Control_CB_upd_Req;//Set module to check for local terminal broadcast status ( AT[?SHC & AT[?SHB )

DIGITAL_OUTPUT _SKIP_,Controller_Mod_Rst_Req;//Tell the controller to reset the module

ANALOG_OUTPUT XT_TE_Mute_Status;//			0=MUTE OFF			   1=MUTE ON						2=Undefined
ANALOG_OUTPUT XT_TE_Privacy_Status;//		0=PRIVACY OFF		   1=PRIVACY ON						2=Undefined
ANALOG_OUTPUT XT_TE_SelfV_Status;//			0=SELFVIEW OFF		   1=SELFVIEW ON					2=Undefined
ANALOG_OUTPUT XT_TE_DnD_Status;//			0=DoNotDisturb OFF	   1=DoNotDisturb ON				2=Undefined
ANALOG_OUTPUT XT_TE_REC_STAT;		//		1=RECording IDLE		2=RECORDING						3=RECording PAUSE			0=Undefined
ANALOG_OUTPUT XT_TE_REC_AVAILABLE;//		0=RECordingNOTavailable	1=RECording available			2=Undefined
ANALOG_OUTPUT XT_TE_PLAY_STAT;		//		1=RECording IDLE		2=RECORDING						3=RECording PAUSE			0=Undefined
ANALOG_OUTPUT XT_TE_PLAY_AVAILABLE;//		0=RECordingNOTavailable	1=RECording available			2=Undefined


ANALOG_OUTPUT XT_TE_MMpresentation_TX_Status;//0=DUAL VIDEO OFF	   1=DUAL VIDEO ON					2=Undefined
ANALOG_OUTPUT XT_TE_MMpresentation_RX_Status;//0=DUAL VIDEO OFF	   1=DUAL VIDEO ON					2=Undefined
ANALOG_OUTPUT XT_TE_Local_Presentation_Status;//0=NOT ACTIVE	   1=ACTIVE							2=Undefined
ANALOG_OUTPUT XT_TE_Live_Call_Status;//			0=Disconnected	   1=Connected						2=Undefined					3=Connecting(IN or OUT)		4=Disconnecting  5=Incoming

ANALOG_OUTPUT XT_TE_Video_Layout;//			1..26 (see documentation) local video layouts			0=Undefined
ANALOG_OUTPUT XT_TE_Multi_Image;//			0..6 (see documentation) local video 'PiP','PaP',PoP'	10=Undefined
ANALOG_OUTPUT XT_TE_Local_Video_Input;//	1=HD1 2=HD2 3=HD2 4=HD3 5=HD4 8=DVI						0=Undefined
ANALOG_OUTPUT XT_TE_ScrSav_Status;//		0=INACTIVE			   1=ACTIVE 						2=Undefined
ANALOG_OUTPUT XT_TE_Volume;//				0=-44....64=+20	
ANALOG_OUTPUT XT_TE_VideoRX_Status,_SKIP_;//0=VIDEOrx OFF		   1=VIDEOrx ON						2=Undefined

DIGITAL_OUTPUT _SKIP_,Connected_FB;
DIGITAL_OUTPUT Now_Disconected;//Pulse when status change.
DIGITAL_OUTPUT Now_Conected;//Pulse when status change.
DIGITAL_OUTPUT Now_Connecting;//Pulse when status change.
DIGITAL_OUTPUT Now_Disconnecting;//Pulse when status change.
DIGITAL_OUTPUT Now_MCUIP_Active;//Pulse when status change.
DIGITAL_OUTPUT Now_Incoming;//Pulse when status change.
DIGITAL_OUTPUT Now_Incoming_In_Call,_SKIP_;//Pulse when status change.

DIGITAL_OUTPUT XT_MCU_Refresh,_SKIP_;//Pulse to ask a complete terminals list status refresh

//-28/07/2015  ANALOG_OUTPUT _SKIP_,XT_DATA_ACK;//0=IDLE  1=OK (ACK_WAIT value match)  2=OutOfPhase 3=Error
 
STRING_OUTPUT XT_TE_Display$;	//Connect it to a call information bar
STRING_OUTPUT XT_TE_InDisplay$;	//Connect it to the incoming call information bar
STRING_OUTPUT XT_TE_REC_Display$;//Connect it to a rec time display
STRING_OUTPUT XT_Test_ExtraDebug_Info$;
