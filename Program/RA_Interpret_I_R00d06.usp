/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/

DIGITAL_INPUT RS232_EN;	//0=IP Communication 1=RS232 Communication

ANALOG_INPUT XT_Mod_DebugLevel;			//Debug output level 0=no messages 99=all messages  

STRING_INPUT Process_I_strings$[50];	//Strings coming from receiver/decoder 

  
  
  
  
  
DIGITAL_OUTPUT XT_RS232_EchoOFF_OS,_SKIP_;	//Request to send echo OFF command to codec

DIGITAL_OUTPUT XT_System_MCU_F,_SKIP_;	//1=System MCU is enabled 0=Not.. 

DIGITAL_OUTPUT XT_Reg_Success_Os,_SKIP_;

DIGITAL_OUTPUT XT_Reset_Request_Os,_SKIP_;

STRING_OUTPUT XT_Test_ExtraDebug_Info$;	//Debug informations

/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/

INTEGER Nop;
STRING RefName[60];
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
//STRING CurrSending$[200];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/



/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/


CHANGE Process_I_strings$
{INTEGER nLen,Cmd_SUB,systm_mcu_en,nInfo[10];
 STRING slong[4],appo[80],appo2[20],trash[20],sINTERF[6],sInfo[10][60];
 STRING commd$[100];
	commd$=Process_I_strings$;
    Cmd_SUB=GetC(commd$);
    nLen=len(commd$);			
	SWITCH(Cmd_SUB)//byte 1
	{					
		CASE('P'):
		{
            //XT_TE_COMM_Reg_Status=3;//TCP=ok IPV=ok
			sInfo[1]=mid(commd$,1,2);//custom boards
			nInfo[1]=byte(commd$,3);//MCU en
			systm_mcu_en=nInfo[1]-0x30;
			sInfo[2]=mid(commd$,4,1);//Board Rev
			nInfo[2]=byte(commd$,5);//Camera
			If (nInfo[2]='9')
			{
				sInfo[3]="Sony";
			}
			Else If (nInfo[2]='A')
			{
				sInfo[3]="Standard";
			}
			Else
			{
				sInfo[3]="Undefined";
			}
			sInfo[4]=Right(commd$,(nlen-5));//Codec
			IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: GET connection to %s HWrev.%s Cam:%s MCU=%u.",RefName,sInfo[4],sInfo[2],sInfo[3],systm_mcu_en);
			//-28072015 CancelTimeOut();
			//SetAckData();
			//SetRegistrationStat(3);//Set status to OK
			PULSE(2,XT_Reg_Success_Os);
			IF (RS232_EN=1) PULSE(2,XT_RS232_EchoOFF_OS);
			XT_System_MCU_F=systm_mcu_en;
		}
		CASE('E'):
		{
			IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV session ENDED.",RefName);
			//TryDisc();
			PULSE(2,XT_Reset_Request_Os);
		}
		CASE('R'):
		{
        	nInfo[1]=byte(commd$,1)-0x30;
			Switch(nInfo[1])
			{
                Case(1):
				{
					sInfo[1]=Right(commd$,(nlen-1));
					IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -bad parameter:%s-",RefName,sInfo[1]);
				}
				Case(2):
				{
					IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -unknown message-",RefName);
                             Nop=1;
				}
				Case(3):
				{
					IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -wrong message length-",RefName);
                             Nop=1;
				}
				Case(4):
				{
					IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -bad mode-",RefName);
                             Nop=1;
				}
				Case(5):
				{
					nInfo[2]=byte(commd$,2)-0x30;
					Switch(nInfo[1])
					{
                        Case(0):
						{
							IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -unable to execute:system timeout-",RefName);
                                     Nop=1;
						}
						Case(1):
						{
							IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -unable to execute:system was busy-",RefName);
                                     Nop=1;
						}
						Default:
						{
							IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR -unable to execute command-",RefName);
                                     Nop=1;
						}
					}
				}
			} //end switch
			IF (XT_Mod_DebugLevel>0) makestring (XT_Test_ExtraDebug_Info$,"%s: IPV connection ERROR %s HWrev.%s Cam:%s MCU=%u.",RefName,sInfo[4],sInfo[2],sInfo[3],systm_mcu_en);
			Nop=1;
		}//end case "E"				
	}//end switch
}//end change



/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
     RefName=GetSymbolReferenceName();
}


