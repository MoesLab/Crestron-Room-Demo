		}
/*************************************************************************************************
	This section will process the list of entries for a group from the global address book.

gaddrbook system 3. name:"Support 400" sys_label:"HDX" sys_id:"10058#10059#10060#10061" phone_num:""type:multicodec
gaddrbook group "Andover ITP" 0 3 done
*************************************************************************************************/
		else if(sTemp1 = "system")
		{
			iMarker3 = find("\x20", Tempstring$, iMarker2 + 1);
			sTemp2 = mid(Tempstring$, iMarker2 + 1, iMarker3 - iMarker2 - 1);
			if(iMarker3 > 0)
			{
				if((len(sTemp2) >= 2) && (byte(sTemp2, len(sTemp2)) = 0x2E))
				{
					iTempEntryNum = atoi(sTemp2);
					iMarker6 = find("name:", Tempstring$);
					iMarker7 = find("\x22", Tempstring$, iMarker6); //Find the " character
					iMarker8 = find("\x22", Tempstring$, iMarker7 + 1); //Find the next " character
					sTempName = mid(Tempstring$, iMarker7 + 1, iMarker8 - iMarker7 - 1);
					if(iTempEntryNum <= Global_Groups[iGlobalGroupRequested].iNumberOfEntries)
					{
						for(a = 1 to iGAddressbookSize)
						{
							if(GlobalAddressbook[a].sName = sTempName)
							{
								Global_Groups[iGlobalGroupRequested].iEntryPointer[iTempEntryNum] = a;
								break;
							}
						}
					}
					else
					{
						siError = resizearray(Global_Groups[iGlobalGroupRequested].iEntryPointer, iTempEntryNum);
						for(a = 1 to iGAddressbookSize)
						{
							if(GlobalAddressbook[a].sName = sTempName)
							{
								Global_Groups[iGlobalGroupRequested].iEntryPointer[iTempEntryNum] = a;
								break;
							}
						}
					}
				}
			}
		}
/*************************************************************************************************
	This section will send the next command to get the global address book.

gaddrbook batch 0 done
*************************************************************************************************/
		else if(sTemp1 = "batch")
		{
			iMarker4 = reversefind("\x20", Tempstring$);
			if(iMarker4 <> 0)
			{
				sTemp2 = mid(Tempstring$, iMarker4 + 1, len(Tempstring$) - iMarker4);
				if(sTemp2 = "range")
				{
					sTempSend = "gaddrbook grouplist size\n";
				}
				else if(sTemp2 = "done")
				{
					if(iTempGlobalBatch < ciMAXBATCH)
					{
						iTempGlobalBatch = iTempGlobalBatch + 1;
						makestring(sTempSend, "gaddrbook batch %d\n", iTempGlobalBatch - 1);
					}
					else
					{
						sTempSend = "gaddrbook grouplist size\n";
					}
				}
			}
		}
/*************************************************************************************************
	This section will process the list of entries for the global address book.

gaddrbook 19. “Polycom HDX Demo 20” h323_spd:384 h323_num:192.168.1.120 h323_ext:
gaddrbook batch 0 done
*************************************************************************************************/
		else if((len(sTemp1) >= 2) && (byte(sTemp1, len(sTemp1)) = 0x2E))
		{
			iTempEntryNum = atoi(sTemp1);
			iMarker7 = find("\x22", Tempstring$); //Find the " character
			iMarker8 = find("\x22", Tempstring$, iMarker7 + 1); //Find the next " character
			sTempName = mid(Tempstring$, iMarker7 + 1, iMarker8 - iMarker7 - 1);
			if(iTempEntryNum <= iGAddressbookSize)
			{
				GlobalAddressbook[iTempEntryNum].sName = sTempName;
				GlobalAddressbook[iTempEntryNum].sType = "";
				GlobalAddressbook[iTempEntryNum].iGroupPointer = 0;
			}
			else
			{
				siError = resizestructurearray(GlobalAddressbook, iTempEntryNum);
				GlobalAddressbook[iTempEntryNum].sName = sTempName;
				GlobalAddressbook[iTempEntryNum].sType = "";
				GlobalAddressbook[iTempEntryNum].iGroupPointer = 0;
			}
			iGAddressbookSize = iTempEntryNum;
		}
	}
}

function fProcessLdapGlobalAddressBook(string fsResponse)
{
	integer fiMarker1, fiMarker2, fiMarker3, fiMarker4, fiMarker5, fiMarker6, fiMarker7, fiMarker8;
	integer fiMarkerQuote1, fiMarkerQuote2, a, fiTemp;
	string fsTemp1[ciMAXCHARS], fsTemp2[ciMAXCHARS], fsTempName[ciMAXDIRCHARS], fsTempLabel[ciMAXDIRCHARS];
	string fsTempId[ciMAXDIRCHARS], fsTempPhoneNum[ciMAXDIRCHARS], fsTempType[ciMAXDIRCHARS];
	//gaddrbook names search s size 5
	if(Enable_Debug)
	{
		trace("fProcessLdapGlobalAddressBook: fsResponse = %s;", fsResponse);
	}
	fiMarker1 = 0;
	fiMarker2 = 0;
	fiMarker3 = 0;
	fiMarker4 = 0;
	fiMarker5 = 0;
	fiMarker6 = 0;
	fiMarker7 = 0;
	fiMarker8 = 0;
	fiMarkerQuote1 = 0;
	fiMarkerQuote2 = 0;
	fiMarker1 = find("\x20", fsResponse);
	fiMarker2 = find("\x20", fsResponse, fiMarker1 + 1);
	if((fiMarker1 <> 0) && (fiMarker2 <> 0))
	{
		fsTemp1 = mid(fsResponse, fiMarker1 + 1, fiMarker2 - fiMarker1 - 1);
		if(Enable_Debug)
		{
			trace("fProcessLdapGlobalAddressBook: fsTemp1 = %s;", fsTemp1);
		}
		if(fsTemp1 = "grouplist")
		{
			fProcessGroup(fsResponse);
		}
		else if(fsTemp1 = "group")
		{
			fProcessGroup(fsResponse);
		}
		else if(fsTemp1 = "names")
		{
			fiMarker3 = reversefind("\x20", fsResponse);
			fsTemp2 = right(fsResponse, len(fsResponse) - fiMarker3);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: names: fsTemp2 = %s;", fsTemp2);
			}
			if(fsTemp2 = "done")
			{
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: names: done: ldapRangeMax = %d, ldapCharacterCount = %d;", ldapRangeMax, ldapCharacterCount);
				}
				if(ldapRangeMax < ldapCharacterCount)
				{
					ldapRangeMin = ldapRangeMin + ciMAXREQUEST;
					ldapRangeMax = ldapRangeMax + ciMAXREQUEST;
					if(Enable_Debug)
					{
						trace("fProcessLdapGlobalAddressBook: names: done: ldapRangeMax < ldapCharacterCount: ldapRangeMin = %d; ldapRangeMax = %d;", ldapRangeMin, ldapRangeMax);
					}
					if(ldapRangeMax > ldapCharacterCount)
					{
						ldapRangeMax = ldapCharacterCount;
						makestring(sTempSend, "gaddrbook names search \x22%s\x22 %d %d\n", sCharacterArray[nextSearchChar], ldapRangeMin, ldapRangeMax);
					}
				}
				else
				{
					if(Enable_Debug)
					{
						trace("fProcessLdapGlobalAddressBook: names: done: nextSearchChar = %d, ciCHARARRAYSIZE = %d;", nextSearchChar, ciCHARARRAYSIZE);
					}
					nextSearchChar = nextSearchChar + 1;
					if(nextSearchChar < ciCHARARRAYSIZE)
					{
						makestring(sTempSend, "gaddrbook names search \x22%s\x22 size\n", sCharacterArray[nextSearchChar]);
					}
					else
					{
						sTempSend = "gaddrbook grouplist size\n";
					}
				}
			}
			else
			{
				if((atoi(fsTemp2) > 0) || ((atoi(fsTemp2) = 0) && (fsTemp2 = "0")))
				{
					ldapCharacterCount = atoi(fsTemp2);
					if(Enable_Debug)
					{
						trace("fProcessLdapGlobalAddressBook: names: not done: ldapCharacterCount = %d;", ldapCharacterCount);
					}
					if(ldapCharacterCount > 0)
					{
						ldapRangeMin = 0;
						if(ldapCharacterCount > ciMAXREQUEST)
						{
							ldapRangeMax = ciMAXREQUEST;
						}
						else
						{
							ldapRangeMax = ldapCharacterCount;
						}
						if(Enable_Debug)
						{
							trace("fProcessLdapGlobalAddressBook: names: not done: ldapRangeMax = %d;", ldapRangeMax);
						}
						makestring(sTempSend, "gaddrbook names search \x22%s\x22 %d %d\n", sCharacterArray[nextSearchChar], ldapRangeMin, ldapRangeMax);
					}
					else if(ldapCharacterCount = 0)
					{
						nextSearchChar = nextSearchChar + 1;
						if(Enable_Debug)
						{
							trace("fProcessLdapGlobalAddressBook: names: not done: nextSearchChar = %d;", nextSearchChar);
						}
						if(nextSearchChar < ciCHARARRAYSIZE)
						{
							makestring(sTempSend, "gaddrbook names search \x22%s\x22 size\n", sCharacterArray[nextSearchChar]);
						}
						else
						{
							sTempSend = "gaddrbook grouplist size\n";
						}
					}
				}
			}
		}
		else if(fsTemp1 = "search")
		{
			fiMarker3 = find("\x20", fsResponse, fiMarker2 + 1);
			fiTemp = atoi(mid(fsResponse, fiMarker2, fiMarker3 - fiMarker2 - 1));
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiTemp = %d;", fiTemp);
			}
			fiMarker4 = find("sys_name:", fsResponse);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiMarker4(sys_name:) = %d;", fiMarker4);
			}
			if(fiMarker4 = 0)
			{
				fiMarker4 = find("name:", fsResponse);
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fiMarker4(name:) = %d;", fiMarker4);
				}
			}
			fiMarker5 = find("sys_label:", fsResponse);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiMarker5(sys_label:) = %d;", fiMarker5);
			}
			fiMarker6 = find("sys_id:", fsResponse);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiMarker6(sys_id:) = %d;", fiMarker6);
			}
			fiMarker7 = find("phone_num:", fsResponse);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiMarker7(phone_num:) = %d;", fiMarker7);
			}
			fiMarker8 = find("type:", fsResponse);
			if(Enable_Debug)
			{
				trace("fProcessLdapGlobalAddressBook: search: fiMarker8(type:) = %d;", fiMarker8);
			}
			if(fiMarker4 > 0)
			{
				fiMarkerQuote1 = find("\x22", fsResponse, fiMarker4);
				if(fiMarkerQuote1 > 0)
				{
					fiMarkerQuote2 = find("\x22", fsResponse, fiMarkerQuote1 + 1);
				}
				else
				{
					fiMarkerQuote1 = find(":", fsResponse, fiMarker4);
					fiMarkerQuote2 = find("\x20", fsResponse);
				}
				fsTempName = mid(fsResponse, fiMarkerQuote1 + 1, fiMarkerQuote2 - (fiMarkerQuote1 + 1));
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fsTempName = %s;", fsTempName);
				}
			}
			fiMarkerQuote1 = 0;
			fiMarkerQuote2 = 0;
			if(fiMarker5 > 0)
			{
				fiMarkerQuote1 = find("\x22", fsResponse, fiMarker5);
				if(fiMarkerQuote1 > 0)
				{
					fiMarkerQuote2 = find("\x22", fsResponse, fiMarkerQuote1 + 1);
				}
				else
				{
					fiMarkerQuote1 = find(":", fsResponse, fiMarker5);
					fiMarkerQuote2 = find("\x20", fsResponse);
				}
				fsTempLabel = mid(fsResponse, fiMarkerQuote1 + 1, fiMarkerQuote2 - (fiMarkerQuote1 + 1));
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fsTemplabel = %s;", fsTempLabel);
				}
			}
			fiMarkerQuote1 = 0;
			fiMarkerQuote2 = 0;
			if(fiMarker6 > 0)
			{
				fiMarkerQuote1 = find("\x22", fsResponse, fiMarker6);
				if(fiMarkerQuote1 > 0)
				{
					fiMarkerQuote2 = find("\x22", fsResponse, fiMarkerQuote1 + 1);
				}
				else
				{
					fiMarkerQuote1 = find(":", fsResponse, fiMarker6);
					fiMarkerQuote2 = find("\x20", fsResponse);
				}
				fsTempId = mid(fsResponse, fiMarkerQuote1 + 1, fiMarkerQuote2 - (fiMarkerQuote1 + 1));
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fsTempId = %s;", fsTempId);
				}
			}
			fiMarkerQuote1 = 0;
			fiMarkerQuote2 = 0;
			if(fiMarker7 > 0)
			{
				fiMarkerQuote1 = find("\x22", fsResponse, fiMarker7);
				if(fiMarkerQuote1 > 0)
				{
					fiMarkerQuote2 = find("\x22", fsResponse, fiMarkerQuote1 + 1);
				}
				else
				{
					fiMarkerQuote1 = find(":", fsResponse, fiMarker7);
					fiMarkerQuote2 = find("\x20", fsResponse);
				}
				fsTempPhoneNum = mid(fsResponse, fiMarkerQuote1 + 1, fiMarkerQuote2 - (fiMarkerQuote1 + 1));
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fsTempPhoneNum = %s;", fsTempPhoneNum);
				}
			}
			fiMarkerQuote1 = 0;
			fiMarkerQuote2 = 0;
			if(fiMarker8 > 0)
			{
				fiMarkerQuote1 = find("\x22", fsResponse, fiMarker8);
				if(fiMarkerQuote1 > 0)
				{
					fiMarkerQuote2 = find("\x22", fsResponse, fiMarkerQuote1 + 1);
				}
				else
				{
					fiMarkerQuote1 = find(":", fsResponse, fiMarker8);
					fiMarkerQuote2 = find("\x20", fsResponse);
				}
				fsTempType = mid(fsResponse, fiMarkerQuote1 + 1, fiMarkerQuote2 - (fiMarkerQuote1 + 1));
				if(Enable_Debug)
				{
					trace("fProcessLdapGlobalAddressBook: search: fsTempType = %s;", fsTempType);
				}
			}
			if(iGAddressbookSize > 0)
			{
				for(a = 0 to iGAddressbookSize - 1)
				{
					if(Enable_Debug)
					{
						trace("fProcessLdapGlobalAddressBook: search: checking names: fsTempName = %s, GlobalAddressBook[%d].sName = %s;", fsTempName, a, GlobalAddressBook[a].sName);
						trace("fProcessLdapGlobalAddressBook: search: checking names: fsTempLabel = %s, GlobalAddressBook[%d].sLabel = %s;", fsTempName, a, GlobalAddressBook[a].sLabel);
					}
					if((fsTempName = GlobalAddressbook[a].sName) || (fsTempLabel = GlobalAddressbook[a].sLabel))
					{
						fsTempName = "";
						fsTempLabel = "";
						fsTempId = "";
						fsTempPhoneNum = "";
						fsTempType = "";
						a = iGAddressbookSize;
					}
				}
				if(a = iGAddressbookSize - 1)
				{
					iEntryCounter = iEntryCounter + 1;
					if(iEntryCounter <= iGAddressbookSize)
					{
						GlobalAddressbook[iEntryCounter].sName = fsTempName;
						GlobalAddressbook[iEntryCounter].sType = fsTempType;
						GlobalAddressbook[iEntryCounter].sLabel = fsTempLabel;
						GlobalAddressbook[iEntryCounter].sId = fsTempId;
						GlobalAddressbook[iEntryCounter].sPhoneNum = fsTempPhoneNum;
						GlobalAddressbook[iEntryCounter].iGroupPointer = 0;
					}
					else
					{
						siError = resizestructurearray(GlobalAddressbook, iEntryCounter);
						GlobalAddressbook[iEntryCounter].sName = fsTempName;
						GlobalAddressbook[iEntryCounter].sType = fsTempType;
						GlobalAddressbook[iEntryCounter].sLabel = fsTempLabel;
						GlobalAddressbook[iEntryCounter].sId = fsTempId;
						GlobalAddressbook[iEntryCounter].sPhoneNum = fsTempPhoneNum;
						GlobalAddressbook[iEntryCounter].iGroupPointer = 0;
					}
					iGAddressbookSize = iEntryCounter;
				}
			}
		}
	}
}

Function PopulateCharArray()
{
	sCharacterArray[0] = "0";
	sCharacterArray[1] = "1";
	sCharacterArray[2] = "2";
	sCharacterArray[3] = "3";
	sCharacterArray[4] = "4";
	sCharacterArray[5] = "5";
	sCharacterArray[6] = "6";
	sCharacterArray[7] = "7";
	sCharacterArray[8] = "8";
	sCharacterArray[9] = "9";
	sCharacterArray[10] = "-";
	sCharacterArray[11] = "_";
	sCharacterArray[12] = "\x5C";// \ character
	sCharacterArray[13] = "/";
	sCharacterArray[14] = ",";
	sCharacterArray[15] = ".";
	sCharacterArray[16] = "@";
	sCharacterArray[17] = "a";
	sCharacterArray[18] = "b";
	sCharacterArray[19] = "c";
	sCharacterArray[20] = "d";
	sCharacterArray[21] = "e";
	sCharacterArray[22] = "f";
	sCharacterArray[23] = "g";
	sCharacterArray[24] = "h";
	sCharacterArray[25] = "i";
	sCharacterArray[26] = "j";
	sCharacterArray[27] = "k";
	sCharacterArray[28] = "l";
	sCharacterArray[29] = "m";
	sCharacterArray[30] = "n";
	sCharacterArray[31] = "o";
	sCharacterArray[32] = "p";
	sCharacterArray[33] = "q";
	sCharacterArray[34] = "r";
	sCharacterArray[35] = "s";
	sCharacterArray[36] = "t";
	sCharacterArray[37] = "u";
	sCharacterArray[38] = "v";
	sCharacterArray[39] = "w";
	sCharacterArray[40] = "x";
	sCharacterArray[41] = "y";
	sCharacterArray[42] = "z";
}

Function fProcessResponse(string fsTempString)
{
	//notification:callstatus:<calldirection>:<call id>:<far site name>:<farsite number>:<connection status>:<callspeed>:<status-specific cause code from callengine>:<calltype>
	//notification:callstatus:incoming:58:Unknown Caller::connecting::0:voiceonly
	if(left(fsTempString, len("notification:callstatus:")) = "notification:callstatus:")
	{
		iMarker1 = find(":", fsTempString);
		iMarker2 = find(":", fsTempString, iMarker1 + 1);
		iMarker3 = find(":", fsTempString, iMarker2 + 1);
		iMarker4 = find(":", fsTempString, iMarker3 + 1);
		iMarker5 = find(":", fsTempString, iMarker4 + 1);
		iMarker6 = find(":", fsTempString, iMarker5 + 1);
		iMarker7 = find(":", fsTempString, iMarker6 + 1);
		iMarker8 = find(":", fsTempString, iMarker7 + 1);
		iMarker9 = find(":", fsTempString, iMarker8 + 1);
		sTempDirection = mid(fsTempString, iMarker2 + 1, iMarker3 - (iMarker2 + 1));
		iTempCallID = atoi(mid(fsTempString, iMarker3 + 1, iMarker4 - (iMarker3 + 1)));
		sTempFEName = mid(fsTempString, iMarker4 + 1, iMarker5 - (iMarker4 + 1));
		sTempFENumber = mid(fsTempString, iMarker5 + 1, iMarker6 - (iMarker5 + 1));
		sTempStatus = mid(fsTempString, iMarker6 + 1, iMarker7 - (iMarker6 + 1));
		sTempCallType = mid(fsTempString, iMarker9 + 1, len(fsTempString) - iMarker9);
		fProcessNotification(sTempCallType);
	}
	else if(left(fsTempString, len("callinfo:")) = "callinfo:")
	{//callinfo:<callid>:<far site name>:<far site number>:<speed>:<connection status>:<mute status>:<call direction>:<call type>
		iMarker1 = find(":", fsTempString);
		iMarker2 = find(":", fsTempString, iMarker1 + 1);
		iMarker3 = find(":", fsTempString, iMarker2 + 1);
		iMarker4 = find(":", fsTempString, iMarker3 + 1);
		iMarker5 = find(":", fsTempString, iMarker4 + 1);
		iMarker6 = find(":", fsTempString, iMarker5 + 1);
		iMarker7 = find(":", fsTempString, iMarker6 + 1);
		iMarker8 = find(":", fsTempString, iMarker7 + 1);
		iTempCallID = atoi(mid(fsTempString, iMarker1 + 1, iMarker2 - (iMarker1 + 1)));
		sTempFEName = mid(fsTempString, iMarker2 + 1, iMarker3 - (iMarker2 + 1));
		sTempFENumber = mid(fsTempString, iMarker3 + 1, iMarker4 - (iMarker3 + 1));
		sTempStatus = mid(fsTempString, iMarker5 + 1, iMarker6 - (iMarker5 + 1));
		sTempDirection = mid(fsTempString, iMarker7 + 1, iMarker8 - (iMarker7 + 1));
		sTempCallType = mid(fsTempString, iMarker8 + 1, len(fsTempString) - iMarker8);
		fProcessNotification(sTempCallType);
	}
	else if(left(fsTempString, len("autoanswer")) = "autoanswer")
	{
		if(find("autoanswer yes", fsTempString) && len(fsTempString) = 16)
		{
			Auto_FB = 1;
		}
		else if(find("autoanswer no", fsTempString) && len(fsTempString) = 15)
		{
			Auto_FB = 0;
		}
	}
	else if(find("addrbook", fsTempString) > 0)
	{
		cancelwait(wGetAddressBookTimeOut);
		if(find("gaddrbook", fsTempString) > 0)
		{
			if(Enable_Debug)
			{
				trace("fProcessResponse: fsTempString = %s, GDS_Available = %d, LDAP_Available = %d;", fsTempString, GDS_Available, LDAP_Available);
			}
			if((!GDS_Available) && (LDAP_Available))
			{
				fProcessLdapGlobalAddressBook(fsTempString);
			}
			else
			{
				fProcessGlobalAddressBook();
			}
		}
		else
		{
			fProcessLocalAddressBook();
		}
		if(len(sTempSend) > 0)
		{
			fGetAddressBookTimeOut();
			ToDevice$ = sTempSend;
			sTempSend = "";
		}
	}
}
/***********************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
***********************************************************************/
CHANGE Enable_Local_Addressbook
{
	iEnableLocal = Enable_Local_Addressbook;
}

CHANGE Enable_Global_Addressbook
{
	iEnableGlobal = Enable_Global_Addressbook;
}

PUSH Get_Addressbooks
{
	if(iAddressBookRequestBusy = 0)
	{
		if(iEnableLocal = 1)
		{
			iAddressBookRequestBusy = 1;
			Get_Addressbooks_Busy = iAddressBookRequestBusy;
			fGetAddressBookTimeOut();
			ToDevice$ = "addrbook names all size\n";
		}
		else if(iEnableGlobal = 1)
		{
			iAddressBookRequestBusy = 1;
			Get_Addressbooks_Busy = iAddressBookRequestBusy;
			fGetAddressBookTimeOut();
			if((!GDS_Available) && (LDAP_Available))
			{
				iEntryCounter = 0;
				nextSearchChar = 0;
				makestring(ToDevice$, "gaddrbook names search \x22%s\x22 size\n", sCharacterArray[nextSearchChar]);
			}
			else if(GDS_Available)
			{
				iTempGlobalBatch = 1;
				ToDevice$ = "gaddrbook batch 0\n";
			}
		}
	}
}

#if_series3
threadsafe RELEASE Process_Receive_String
{
	While((find("\x0D\x0A", Polycom_Rx$) > 0) || (find("\x0A\x0D", Polycom_Rx$) > 0))
	{
		mark1 = find("\x0D\x0A", Polycom_Rx$);
		mark2 = find("\x0A\x0D", Polycom_Rx$);
		if(((mark1 < mark2) && (mark1 > 0) && (mark2 > 0)) || (mark2 = 0)) 
		{
			Tempstring$ = Remove("\x0D\x0A", Polycom_Rx$);
			Tempstring$ = left(Tempstring$, len(Tempstring$) - 2);
			if(len(Tempstring$) > 0)
			{
				While((len(Tempstring$) > 0) && ((byte(Tempstring$, 1) = 13) || (byte(Tempstring$, 1) = 10) || (byte(Tempstring$, 1) = 45) || (byte(Tempstring$, 1) = 62) || (byte(Tempstring$, 1) = 32)))
				{
					Junk = getc(Tempstring$);
				}
			}
		}
		else
		{
			Tempstring$ = Remove("\x0A\x0D", Polycom_Rx$);
			Tempstring$ = left(Tempstring$, len(Tempstring$) - 2);
			if(len(Tempstring$) > 0)
			{
				While((len(Tempstring$) > 0) && ((byte(Tempstring$, 1) = 13) || (byte(Tempstring$, 1) = 10) || (byte(Tempstring$, 1) = 45) || (byte(Tempstring$, 1) = 62) || (byte(Tempstring$, 1) = 32)))
				{
					Junk = getc(Tempstring$);
				}
			}
		}
		if(len(Tempstring$) > 0)
		{
			if(Enable_Debug)
			{
				trace("Process_Receive_String: Tempstring$ = %s;", Tempstring$);
			}
			fProcessResponse(Tempstring$);
		}
		TempString$ = "";
	}
}
#else
RELEASE Process_Receive_String
{
	if(RxOk = 1)
	{
		RxOk = 0; 
		While((find("\x0D\x0A", Polycom_Rx$) > 0) || (find("\x0A\x0D", Polycom_Rx$) > 0))
		{
			mark1 = find("\x0D\x0A", Polycom_Rx$);
			mark2 = find("\x0A\x0D", Polycom_Rx$);
			if(((mark1 < mark2) && (mark1 > 0) && (mark2 > 0)) || (mark2 = 0)) 
			{
				Tempstring$ = Remove("\x0D\x0A", Polycom_Rx$);
				Tempstring$ = left(Tempstring$, len(Tempstring$) - 2);
				if(len(Tempstring$) > 0)
				{
					While((len(Tempstring$) > 0) && ((byte(Tempstring$, 1) = 13) || (byte(Tempstring$, 1) = 10) || (byte(Tempstring$, 1) = 45) || (byte(Tempstring$, 1) = 62) || (byte(Tempstring$, 1) = 32)))
					{
						Junk = getc(Tempstring$);
					}
				}
			}
			else
			{
				Tempstring$ = Remove("\x0A\x0D", Polycom_Rx$);
				Tempstring$ = left(Tempstring$, len(Tempstring$) - 2);
				if(len(Tempstring$) > 0)
				{
					While((len(Tempstring$) > 0) && ((byte(Tempstring$, 1) = 13) || (byte(Tempstring$, 1) = 10) || (byte(Tempstring$, 1) = 45) || (byte(Tempstring$, 1) = 62) || (byte(Tempstring$, 1) = 32)))
					{
						Junk = getc(Tempstring$);
					}
				}
			}
			if(len(Tempstring$) > 0)
			{
				fProcessResponse(Tempstring$);
			}
			TempString$ = "";
		}
		RxOk = 1;
	}
}
#endif

PUSH Audio_Keypad
{
	iTempKey = getlastmodifiedarrayindex();
	
	if(iAudioHookState = 1)//Off Hook
	{
		switch(iTempKey)
		{
			case(ciKEYSTAR):
			{
				if(Enable_DTMF_In_Dial_String = 1)
				{
					if(len(sTempDialString) < Max_Characters)
					{
						sTempDialString = sTempDialString + "*";
					}
					else
					{
						sTempDialString = left(sTempDialString, len(sTempDialString) - 1) + "*";
					}
					Dial_String = sTempDialString;
				}
				ToDevice$ = "gendial *\n";
			}
			case(ciKEYPOUND):
			{
				if(Enable_DTMF_In_Dial_String = 1)
				{
					if(len(sTempDialString) < Max_Characters)
					{
						sTempDialString = sTempDialString + "#";
					}
					else
					{
						sTempDialString = left(sTempDialString, len(sTempDialString) - 1) + "#";
					}
					Dial_String = sTempDialString;
				}
				ToDevice$ = "gendial #\n";
			}
			case(ciKEYPAUSE):
			{
				//Do Nothing
			}
			case(ciKEYCLEAR):
			{
				//Do Nothing
			}
			case(ciKEYBACKSPACE):
			{
				//Do Nothing
			}
			default:
			{
				if(Enable_DTMF_In_Dial_String = 1)
				{
					if(len(sTempDialString) < Max_Characters)
					{
						makestring(sTempDialString, "%s%d", sTempDialString, iTempKey - 1);
					}
					else
					{
						makestring(sTempDialString, "%s%d", left(sTempDialString, len(sTempDialString) - 1), iTempKey - 1);
					}
					Dial_String = sTempDialString;
				}
				makestring(ToDevice$, "gendial %d\n", iTempKey - 1);
			}
		}
	}
	else//On Hook
	{
		switch(iTempKey)
		{
			case(ciKEYSTAR):
			{
				if(len(sTempDialString) < Max_Characters)
				{
					sTempDialString = sTempDialString + "*";
					Dial_String = sTempDialString;
				}
			}
			case(ciKEYPOUND):
			{
				if(len(sTempDialString) < Max_Characters)
				{
					sTempDialString = sTempDialString + "#";
					Dial_String = sTempDialString;
				}
			}
			case(ciKEYPAUSE):
			{
				if(len(sTempDialString) < Max_Characters)
				{
					sTempDialString = sTempDialString + ",";
					Dial_String = sTempDialString;
				}
			}
			case(ciKEYCLEAR):
			{
				sTempDialString = "";
				Dial_String = sTempDialString;
			}
			case(ciKEYBACKSPACE):
			{
				sTempDialString = left(sTempDialString, len(sTempDialString) - 1);
				Dial_String = sTempDialString;
			}
			default:
			{
				if(len(sTempDialString) < Max_Characters)
				{
					makestring(sTempDialString, "%s%d", sTempDialString, iTempKey - 1);
					Dial_String = sTempDialString;
				}
			}
		}
	}
}
    
PUSH Audio_Dial
{
	switch(Audio_Call_Type)
	{
		case(1)://POTS
		{
