PUSH Global_Addressbook_Select
{
	iTemp = getlastmodifiedarrayindex();
	if(GlobalEntryValid[iTemp] = 1)
	{
		iTemp = (iTemp - 1) + ((iCurrentGlobalPage - 1) * EntriesPerScreen);
		if(iCurrentGlobalLevel = 0)
		{
			if(GlobalAddressBook[iTemp].sType = "group")
			{
				fAddToGlobalReturnStack(iCurrentGlobalLevel, iCurrentGlobalPage);
				iCurrentGlobalLevel = GlobalAddressBook[iTemp].iGroupPointer;
				iCurrentGlobalPage = 1;
				if((Global_Groups[iCurrentGlobalLevel].iNumberOfEntries mod EntriesPerScreen) = 0)
				{
					iGlobalAddrTotalPages = Global_Groups[iCurrentGlobalLevel].iNumberOfEntries / EntriesPerScreen;
				}
				else
				{
					iGlobalAddrTotalPages = (Global_Groups[iCurrentGlobalLevel].iNumberOfEntries / EntriesPerScreen) + 1;
				}
				Global_Addressbook_CurrentPage = iCurrentGlobalPage;
				Global_Addressbook_TotalPages = iGlobalAddrTotalPages;
				Global_Addressbook_List_Name_Text = Global_Groups[iCurrentGlobalLevel].sName;
				for(a = 1 to 25)
				{
					Global_Addressbook_Name$[a] = "";
					Global_Addressbook_Number$[a] = "";
					GlobalEntryValid[a] = 0;
				}
				for(a = 1 to EntriesPerScreen)
				{
					if(a <= Global_Groups[iCurrentGlobalLevel].iNumberOfEntries)
					{
						b =  (a - 1) + ((iCurrentGlobalPage - 1) * EntriesPerScreen);
						if(GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[b]].sType = "group")
						{
							Global_Addressbook_Name$[a] = csGROUPPREFIX + GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[b]].sName;
						}
						else
						{
							Global_Addressbook_Name$[a] = GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[b]].sName;
						}
						GlobalEntryValid[a] = 1;
					}
					else
					{
						break;
					}
				}
			}
			else
			{
				Global_Addressbook_NameSelected$ = GlobalAddressBook[iTemp].sName;
				Global_Addressbook_NumberSelected$ = "";
				Global_Addressbook_SpeedSelected$ = "";
				makestring(sTempGlobalDialString, "dial addressbook \x22%s\x22\n", GlobalAddressBook[iTemp].sName);
			}
		}
		else if((iCurrentGlobalLevel > 0) && (iCurrentGlobalLevel <= iGAddrGroupSize))
		{
			if(GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[iTemp]].sType = "group")
			{
				fAddToGlobalReturnStack(iCurrentGlobalLevel, iCurrentGlobalPage);
				iCurrentGlobalLevel = GlobalAddressBook[Global_Groups[iCurrentGlobalLevel].iEntryPointer[iTemp]].iGroupPointer;
				iCurrentGlobalPage = 1;
