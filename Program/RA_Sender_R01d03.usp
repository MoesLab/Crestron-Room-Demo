#IF_SERIES3

	THREADSAFE CHANGE bin_Lpoll$
	{
	    IF ((Enable>0)&&(LastRegStatus=KREG_ALLOK))
		{
			Try
			{
				GlobalTmpStringLo=bin_Lpoll$;
				
				If (Len(GlobalTmpStringLo)) 
				{
					GlobalCmdTypeLo=Identify_command(0);
					AddUniqueItem();
				}
			}
			Catch
			{
				Print("%s: Lo buffer input CATCH ERROR: %s !!",RefName,GetExceptionMessage());
			}			
		}
	}
	
#ELSE   //If 2nd series

    CHANGE bin_Lpoll$
	{
	    IF ((Enable>0)&&(LastRegStatus=KREG_ALLOK))
		{
			GlobalTmpStringLo=bin_Lpoll$;
			
			If (Len(GlobalTmpStringLo)) 
			{
				GlobalCmdTypeLo=Identify_command(0);
				AddUniqueItem();
			}			
		}
	}

#ENDIF


/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
Function Main()
{
    RefName=GetSymbolReferenceName();
	WaitForInitializationComplete();
	All_Reset();
    IF (Enable=1)
    {
   			EvaluateRegStat();
    }
    #IF_SERIES3

	    While(1)
	    {
	    	Try
	 		{
	 			GlobalTmpStringHi=Gather("\x0D", bin_Hcmd$);
				IF ((Enable>0)&&(LastRegStatus>KREG_TCPTRY))
				{
					If (Len(GlobalTmpStringHi)>2) 
					{
						GlobalCmdTypeHi=Identify_command(1);
						AddItem();
					}
				}
	 		}
	 		Catch
	 		{
	 			Print("%s: Hi buffer input CATCH ERROR: %s !!",RefName,GetExceptionMessage());
	 		}
	    }
	
	#ELSE   //If 2nd series
    
    	While(1)
	    {
	    	If (Second_series_semaphore=0)
	    	{
	    		Second_series_semaphore=1;	
		    	GlobalTmpStringHi=Gather("\x0D", bin_Hcmd$);
				IF ((Enable>0)&&(LastRegStatus>KREG_TCPTRY))
				{
					If (Len(GlobalTmpStringHi)>2) 
					{
						GlobalCmdTypeHi=Identify_command(1);
						AddItem();
					}
				}
				Second_series_semaphore=0;
			}
	    }
    
	#ENDIF
	
}
