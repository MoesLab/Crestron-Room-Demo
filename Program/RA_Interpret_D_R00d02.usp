PUSH Compose_number
{
	End_Read_All();
	IF ((XT_RP_Selected_Entry>0)||(XT_DIR_Selected_Entry>0))
	{
		Makestring(XT_TE_Display_Number$," ");
	}
	XT_RP_Selected_Entry=0;
	XT_DIR_Selected_Entry=0;
}

PUSH Dial
{String Sinfo[3][2];
	End_Read_All();
	IF (XT_RP_Selected_Entry>0)
	{
		Makestring(XT_TE_HiSEND$,"AT[&CD1R1%03u\r",(RPEntry[XT_RP_Selected_Entry].Uid-1));
		XT_RP_Selected_Entry=0;
		XT_DIR_Selected_Entry=0;
	}
	ELSE IF (XT_DIR_Selected_Entry>0)
	{
		Makestring(XT_TE_HiSEND$,"AT[&CD1C1%03u\r",(DirEntry[XT_DIR_Selected_Entry].Uid-1));
		XT_RP_Selected_Entry=0;
		XT_DIR_Selected_Entry=0;
	}
	Else
	{
		XT_RP_Selected_Entry=0;
		XT_DIR_Selected_Entry=0;
		
		IF (Len(NrToCall$)>0)
		{	
			IF(XT_TE_CallType=1)
			{
				Sinfo[1]="1";
			}
			Else IF(XT_TE_CallType=2)
			{
				Sinfo[1]="8";
			}
			Else
			{
				Sinfo[1]="8";
			}
			
			IF(XT_TE_CallInterf=1)
			{
				Sinfo[2]="1";//IP
			}
			Else IF(XT_TE_CallInterf=2)
			{
				Sinfo[2]="6";//Sip
			}
			Else IF(XT_TE_CallInterf=3)
			{
				Sinfo[2]="7";//ISDN
			}
			Else IF(XT_TE_CallInterf=4)
			{
				Sinfo[2]="5";//MCU
			}
			Else
			{
				Sinfo[2]="1";//IP
			}
			
			SWITCH(XT_TE_CallRate)
			{
				Case(1):Sinfo[3]="1";//64Kbps
				Case(2):Sinfo[3]="2";//128Kbps
				Case(3):Sinfo[3]="3";//192Kbps
				Case(4):Sinfo[3]="4";//256Kbps
				Case(5):Sinfo[3]="5";//320Kbps
				Case(6):Sinfo[3]="6";//384Kbps
				Case(7):Sinfo[3]="7";//448Kbps
				Case(8):Sinfo[3]="8";//512Kbps
				Case(9):Sinfo[3]="C";//768Kbps
				Case(10):Sinfo[3]="R";//896Kbps
				Case(11):Sinfo[3]="S";//1024Kbps
				Case(12):Sinfo[3]="D";//1152Kbps
				Case(13):Sinfo[3]="T";//1280Kbps
				Case(14):Sinfo[3]="U";//1408Kbps
				Case(15):Sinfo[3]="E";//1472Kbps
				Case(16):Sinfo[3]="F";//1536Kbps
				Case(17):Sinfo[3]="O";//1728Kbps
				Case(18):Sinfo[3]="G";//1920Kbps
				Case(19):Sinfo[3]="Q";//2048Kbps
				Case(20):Sinfo[3]="H";//2560Kbps
				Case(21):Sinfo[3]="I";//3072Kbps
				Case(22):Sinfo[3]="J";//3584Kbps
				Case(23):Sinfo[3]="K";//4096Kbps
				Case(24):Sinfo[3]="P";//4608Kbps
				Case(25):Sinfo[3]="L";//5120Kbps
				Case(26):Sinfo[3]="M";//5632Kbps
				Case(27):Sinfo[3]="N";//6144Kbps
				DEFAULT:Sinfo[3]="K";//4096Kbps
			}
			IF (XT_TE_CallRate=0)//Auto
			{
				Makestring(XT_TE_HiSEND$,"AT[&CD1%s%s%s\r",Sinfo[1],Sinfo[2],NrToCall$);
			}
			Else
			{
				Makestring(XT_TE_HiSEND$,"AT[&CM%s%s%s0%s\r",Sinfo[1],Sinfo[2],Sinfo[3],NrToCall$);
			}
		}
	}
}

CHANGE XT_TE_Nr_to_Call$
{
	Makestring(NrToCall$,"%s",XT_TE_Nr_to_Call$);
	XT_RP_Selected_Entry=0;
	XT_DIR_Selected_Entry=0;
	Makestring(XT_TE_Display_Number$,"%s",NrToCall$);
}

PUSH XT_DIR_Start
{
   If (Enable>0)
   		Start_Read_DIR();
}

PUSH XT_DIR_Stop
{
   	If ((Enable>0)&&(Dir_reading=1))
   	{
   		End_Read_Dir();
   	}
}

PUSH XT_DIR_prev1_Page
{
   
   		DIR_PAGE_dec(1);
}

PUSH XT_DIR_prev5_Page
{
   If (Enable>0)
   		DIR_PAGE_dec(5);
}

PUSH XT_DIR_next1_Page
{
    If (Enable>0)    
        DIR_PAGE_inc(1);
}

PUSH XT_DIR_next5_Page
{
    If (Enable>0)
    	DIR_PAGE_inc(5);	
}

CHANGE XT_DIR_GoTo_Page
{
	If (Enable>0)
	{
		IF (XT_DIR_GoTo_Page>0)
		{
			DIR_PAGE_goto(XT_DIR_GoTo_Page);
		}
	}
}

CHANGE XT_DIR_MAX_Entries_p_Page
{
	If (XT_DIR_MAX_Entries_p_Page<=MAX_POSSIBLE_DIR_ENTRIES)
	{
		Dir_Tot_Entry_pp=XT_DIR_MAX_Entries_p_Page;		
	}
	Else
	{
		Dir_Tot_Entry_pp=9;
	}
}

PUSH XT_RP_Start
{
   If (Enable>0)
   		Start_Read_RP();
}

PUSH XT_RP_Stop
{
   	If ((Enable>0)&&(RP_reading=1))
   	{
   		End_Read_RP();
   	}
}

PUSH XT_RP_prev1_Page
{
   If (Enable>0)
   		RP_PAGE_dec(1);
}

PUSH XT_RP_prev3_Page
{
   If (Enable>0)
   		RP_PAGE_dec(3);
}

PUSH XT_RP_next1_Page
{
   If (Enable>0)
   		RP_PAGE_inc(1);
}

PUSH XT_RP_next3_Page
{
    If (Enable>0)
    	RP_PAGE_inc(3);
}

CHANGE XT_RP_GoTo_Page
{
	If (Enable>0)
	{
		IF (XT_RP_GoTo_Page>0)
		{
			RP_PAGE_goto(XT_RP_GoTo_Page);
		}
	}
}

CHANGE XT_RP_MAX_Entries_p_Page
{
	If (XT_RP_MAX_Entries_p_Page<=MAX_POSSIBLE_RP_ENTRIES)
	{
		RP_Tot_Entry_pp=XT_RP_MAX_Entries_p_Page;		
	}
	Else
	{
		RP_Tot_Entry_pp=9;
	}
}


PUSH XT_RPDIR_Entry_UnSel
{
    XT_DIR_Selected_Entry=0;
	XT_RP_Selected_Entry=0;
	Makestring(XT_TE_Display_Number$,"");
}

PUSH XT_RP_Entry_Sel
{Integer esn;
	esn=GetLastModifiedArrayIndex();
	If (RPEntry[esn].Uid>0)
	{
		XT_DIR_Selected_Entry=0;
		XT_RP_Selected_Entry=esn;
		Makestring(XT_TE_Display_Number$,"Recall: %s%s",RPEntry[esn].Number1,RPEntry[esn].Number2);
	}
	Else
	{
		XT_DIR_Selected_Entry=0;
		XT_RP_Selected_Entry=0;
		Makestring(XT_TE_Display_Number$,"");
	}
}


PUSH XT_DIR_Entry_Sel
{Integer esn;
	esn=GetLastModifiedArrayIndex();
	If (DirEntry[esn].Uid>0)
	{
		XT_RP_Selected_Entry=0;
		XT_DIR_Selected_Entry=esn;
		Makestring(XT_TE_Display_Number$,"Call Contact: %s",DirEntry[esn].SName);
	}
	Else
	{
		XT_RP_Selected_Entry=0;
		XT_DIR_Selected_Entry=0;
		Makestring(XT_TE_Display_Number$,"");
	}
}


THREADSAFE CHANGE Process_D_strings$
{
	If (ProcDon=0)
	{
		ProcDon=1;
		ParseDstr();
	}
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{      
     RefName=GetSymbolReferenceName();
     WaitForInitializationComplete();
     	InitializeVars();    
}


