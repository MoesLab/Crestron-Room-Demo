Function UpdateTEnames()
{integer nmx;
   /*
   For(nmx=1 to MAX_TE)
    {
    	If (MCU_TE[nmx].Conn=kCONN)
    	{
	    	If(len(MCU_TE[nmx].TEname))
	    	{
	    		XT_TE_Name$[nmx]=MCU_TE[nmx].TEname;
	    	}
	    	Else
	    	{
	    		XT_TE_Name$[nmx]=" ";
	    	}
	    }
	    Else If (MCU_TE[nmx].Conn=kDISC)
	    {
	    	XT_TE_Name$[nmx]="Disconnected";
			MCU_TE[nmx].TEname="";
	    }
	    Else
	    {
	    	XT_TE_Name$[nmx]="--";
			//MCU_TE[nmx].TEname="";
	    }
    }
    */
    
    //Avoid loops
    If (MCU_TE[1].Conn=kCONN)//TERMINAL 00 Local
    {
    	If(len(MCU_TE[1].TEname))
    	{
    		XT_TE_Name$[1]=MCU_TE[1].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[1]=" ";
    	}
    }
    Else If (MCU_TE[1].Conn=kDISC)
    {
    	XT_TE_Name$[1]="Disconnected";
		MCU_TE[1].TEname="";
    }
    Else
    {
    	XT_TE_Name$[1]="--";
    }
    
    
    
    If (MCU_TE[2].Conn=kCONN)//TERMINAL 01
    {
    	If(len(MCU_TE[2].TEname))
    	{
    		XT_TE_Name$[2]=MCU_TE[2].TEname;
    	}
    	Else
    	{
