/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER Nop;
STRING RefName[60];
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
//STRING CurrSending$[200];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/

Function InitializeVars()
{  
    XT_TE_Network=0;//undefined
    XT_TE_CallStatus=0;//undefined
    XT_TE_VideoRXon=2;//undefined
    XT_TE_DataRXon=2;//undefined
    XT_TE_Number$=" ";
    XT_TE_AudioCoding=222;//undefined
    XT_TE_VideoCoding=222;//undefined
    XT_TE_DV_Status=2;//undefined
    XT_TE_DV_Input=0;//undefined
}


/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Enable
{
    InitializeVars();
}

RELEASE Enable
{
   InitializeVars();
}

CHANGE Process_C_strings$
{INTEGER nLen,Cmd_SUB,systm_mcu_en,nInfo[10];
 INTEGER ikack,tmpack;
 STRING slong[4],appo[80],appo2[20],trash[20],sINTERF[6],sInfo[10][60];
 STRING commd$[100];
	commd$=Process_C_strings$;
    Cmd_SUB=GetC(commd$);
    nLen=len(commd$);
    ikack=999;			
	SWITCH(Cmd_SUB)//byte 1
	{					
		CASE('B')://Connection Status CB
		{
                     //network 1 Byte
			IF	   (byte(commd$,1)='1')//SIP
			{
                          XT_TE_Network=1;
			}
			Else IF(byte(commd$,1)='5')//IP
			{
                         XT_TE_Network=5;
			}
            Else IF(byte(commd$,1)='6')//MCU
			{
                         XT_TE_Network=6;
			}
            Else IF(byte(commd$,1)='7')//ISDN
			{
                         XT_TE_Network=7;
			}

			//Call Status 2 bytes
			nInfo[1]=ATOI(MID(commd$, 2, 2));
                     XT_TE_CallStatus=nInfo[1];//0=undefined 2=idle....31=MCU active
            
            
            //Video Active
            IF    (byte(commd$,4)='0')
			{
                     XT_TE_VideoRXon=0;//not active
			}
			Else IF(byte(commd$,4)='1')
			{
                     XT_TE_VideoRXon=1;//active
			}
            
            //Data Channel
            IF    (byte(commd$,5)='0')
			{
                     XT_TE_DataRXon=0;//not active
			}
			Else IF(byte(commd$,5)='1')
			{
                     XT_TE_DataRXon=1;//active
			}
            
			sInfo[1]=right(commd$,(nLen-5));
			makestring (XT_TE_Number$,"%s",sInfo[1]);
            ikack=124;
            
		}//end 'CB'
		CASE('L')://Connection H323 Status (CL)
		{
			nInfo[1]=ATOI(MID(commd$, 1, 2));//00=Audio Off 01=G723 etc...
			nInfo[2]=ATOI(MID(commd$, 3, 2));//00=Video Off 01=H261 Cif etc...                     	
			XT_TE_AudioCoding=nInfo[1];
			XT_TE_VideoCoding=nInfo[2];
			ikack=125;
		}//end 'CL'
		CASE('C')://Dual Video Status
		{
            IF (byte(commd$,1)='0')
			{
                          XT_TE_DV_Status=0;
			}
			Else IF(byte(commd$,1)='1')
			{
                         XT_TE_DV_Status=1;
			}
			nInfo[1]=ATOI(MID(commd$, 2, 2));//08=DVI etc...
			XT_TE_DV_Input=nInfo[1];
			ikack=127;
		}
        CASE('E')://ERROR
		{
			SWITCH(byte(commd$,3))
			{
				CASE('1'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Bad parameter !",RefName);
					ikack=60001;
				}
				CASE('2'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unknown message !",RefName);
					ikack=60002;	
				}
				CASE('3'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Wrong message lenght !",RefName);
					ikack=60003;
				}
				CASE('4'):
				{
					sInfo[1]=right(commd$,(nLen-1));
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Bad mode on param ID: %s !",RefName,sInfo[1]);
					ikack=60004;
				}
				CASE('5'):
				{
					SWITCH(byte(commd$,4))
					{
						CASE('0'):
						{
							IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unable to execute command (system timeout) !",RefName);
							ikack=60010;
						}
						CASE('1'):
						{
							IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unable to execute command (system busy) !",RefName);
							ikack=60011;
						}
					}
				}
			}
		}				
	}//end main switch byte 1
	
}//End CHANGE event



/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
     InitializeVars(); 
     RefName=GetSymbolReferenceName();
    // WaitForInitializationComplete();
    
}


