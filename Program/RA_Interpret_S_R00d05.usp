DIGITAL_INPUT Enable;
DIGITAL_INPUT XT_UI_Vol_Process;
DIGITAL_INPUT XT_Plus_Accept; //Accept the current additional incoming call(MCU)
DIGITAL_INPUT XT_Plus_Reject; //Reject the current additional incoming call(MCU)
