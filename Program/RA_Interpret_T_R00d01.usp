/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/

Function InitializeVars()
{
    XT_TE_TELEP=2;//undefined
}

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Enable
{
    InitializeVars();
}

RELEASE Enable
{
   InitializeVars();
}


CHANGE Process_T_strings$
{INTEGER nLen,Cmd_SUB,systm_mcu_en,nInfo[10];
 INTEGER ikack,tmpack;
 STRING slong[4],appo[80],appo2[20],trash[20],sINTERF[6],sInfo[10][60];
 STRING commd$[100];
	commd$=Process_T_strings$;
    Cmd_SUB=GetC(commd$);
    nLen=len(commd$);
    ikack=999;			
	SWITCH(Cmd_SUB)//byte 1
	{					
		/* old firmware
		CASE('A')://Connection Status TA
		{
                     // Call-answer mode parameters  1 Byte
			IF	   (byte(commd$,1)='N')//TAN = Do Not Disturb Active ON/OFF
			{
                         //"Do Not Disturb" activation report
	            IF    (byte(commd$,2)='0')
				{
	                     XT_TE_DND=0;//DND not active
				}
				Else IF(byte(commd$,2)='1')
				{
	                     XT_TE_DND=1;//DND active
				}
			}
            ikack=140;
		}//end 'TA'
		*/
		CASE('P')://Telepresence Configuration (TPG)
		{
			// Call-answer mode parameters  1 Byte
			IF	   (byte(commd$,1)='G')//TPG = TELEPRESENCE MODE Active ON/OFF
			{
                         //"TELEPRESENCE" config report
	            IF    (byte(commd$,2)='0')
				{
	                     XT_TE_TELEP=0;//TELEPRESENCE not active
				}
				Else IF(byte(commd$,2)='1')
				{
	                     XT_TE_TELEP=1;//TELEPRESENCE active
				}
			}
			ikack=144;
		}//end 'TP'
        CASE('E')://ERROR
		{
			SWITCH(byte(commd$,3))
			{
				CASE('1'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Bad parameter !",RefName);
					ikack=60001;
				}
				CASE('2'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unknown message !",RefName);
					ikack=60002;	
				}
				CASE('3'):
				{
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Wrong message lenght !",RefName);
					ikack=60003;
				}
				CASE('4'):
				{
					sInfo[1]=right(commd$,(nLen-1));
					IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Bad mode on param ID: %s !",RefName,sInfo[1]);
					ikack=60004;
				}
				CASE('5'):
				{
					SWITCH(byte(commd$,4))
					{
						CASE('0'):
						{
							IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unable to execute command (system timeout) !",RefName);
							ikack=60010;
						}
						CASE('1'):
						{
							IF (XT_Mod_DebugLevel>1) makestring (XT_Test_ExtraDebug_Info$,"%s: CE : Unable to execute command (system busy) !",RefName);
							ikack=60011;
						}
					}
				}
			}
		}				
	}//end main switch byte 1
}//End CHANGE event



/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
     InitializeVars(); 
     RefName=GetSymbolReferenceName();
    // WaitForInitializationComplete();
    
}


