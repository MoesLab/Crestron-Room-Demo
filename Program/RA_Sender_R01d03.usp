/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
PUSH Rst
{
    ResetBuffer();
}

CHANGE Enable
{
    ResetBuffer();
}

CHANGE MaxSendRepeat
{
	MaxResend=MaxSendRepeat;
}

PUSH DBG_PrintVars
{
	FncPrintVars("user");
}

CHANGE XT_TE_RTS
{
	var_RTS=XT_TE_RTS;
	SECURE_count=0;
}

CHANGE XT_TE_COMM_Reg_Status
{
    EvaluateRegStat();
}



CHANGE XT_UI_FastVolUpdate
{
	IF ((Enable>0)&&(LastRegStatus=KREG_ALLOK))
	{
		newVOLvalue064=XT_UI_FastVolUpdate;
		SendFastVol();
	}
}

