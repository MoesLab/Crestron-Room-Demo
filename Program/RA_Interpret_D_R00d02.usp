STRUCTURE PhoneBookEntry
{
	INTEGER SeqWord;//16 bit to check msg
	STRING SName[64];
	STRING SCompany[64];
	STRING SNumber[64];
	INTEGER Uid;//field id (1-xxx) PAY ATTENTION, ID from 0 to xxx are stored as 1 to xxx+1 and 0 means invalid. When you pass the id to the comm module remember to subtract 1 before.
};

STRUCTURE RecallEntry
{
	INTEGER SeqWord;//16 bit to check msg
	INTEGER Uid;//field id (1-100) PAY ATTENTION, ID from 0 to xxx are stored as 1 to xxx+1 and 0 means invalid. When you pass the id to the comm module remember to subtract 1 before.	
	STRING Name1[64];// field number/address/alias
	STRING Name2[64];// additional field number/address/alias
	STRING Number1[64];// field number/address/alias
	STRING Number2[64];// additional field number/address/alias
	INTEGER Direction;//0=Undefined 1=Outgoing 2=Incoming
	STRING sInterf[4];// IP - SIP - ISDN string format
	INTEGER nInterf;// 0=IP - 1=SIP - 2=ISDN numeric format
	INTEGER nType;//0=AV 1=Speec 2=Undefined
	STRING lcDate[10];// DD/MM/YYYY
	STRING lcTime[5];// HH:MM
	STRING lcDuration[8];// HH:MM:SS
};
