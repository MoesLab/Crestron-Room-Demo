STRUCTURE CallRegisterType
{
	STRING Number[100];
	INTEGER Connected;//0=disconnected 1=connected 2=Undef 3=ringing/proceeding 4=Disconnecting 5=Incoming
	INTEGER Interf;//0=IP 1=Sip 2=Undef.
	INTEGER Type;//0=A/V 1=Audio Only 2=Undef. 
	INTEGER Rate;//0=Default 1-23 Rates 64k-6M
	INTEGER Direction;//0=Undef. 1=Outgoing 2=Incoming
	INTEGER VideoRxON;//0=OFF 1=ON 2=Undef.
	INTEGER Channels;//1..15 aggregate channels number
	INTEGER CallId;
	INTEGER MCUCallId;
};

