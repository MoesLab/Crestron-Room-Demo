		MCU_TE[3].TEname="";
    }
    Else
    {
    	XT_TE_Name$[3]="--";
    }
    
    
    
    If (MCU_TE[4].Conn=kCONN)
    {
    	If(len(MCU_TE[4].TEname))
    	{
    		XT_TE_Name$[4]=MCU_TE[4].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[4]=" ";
    	}
    }
    Else If (MCU_TE[4].Conn=kDISC)
    {
    	XT_TE_Name$[4]="Disconnected";
		MCU_TE[4].TEname="";
    }
    Else
    {
    	XT_TE_Name$[4]="--";
    }
    
    
    
    If (MCU_TE[5].Conn=kCONN)
    {
    	If(len(MCU_TE[5].TEname))
    	{
    		XT_TE_Name$[5]=MCU_TE[5].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[5]=" ";
    	}
    }
    Else If (MCU_TE[5].Conn=kDISC)
    {
    	XT_TE_Name$[5]="Disconnected";
		MCU_TE[5].TEname="";
    }
    Else
    {
    	XT_TE_Name$[5]="--";
    }
    
    
    
    If (MCU_TE[6].Conn=kCONN)
    {
    	If(len(MCU_TE[6].TEname))
    	{
    		XT_TE_Name$[6]=MCU_TE[6].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[6]=" ";
    	}
    }
    Else If (MCU_TE[6].Conn=kDISC)
    {
    	XT_TE_Name$[6]="Disconnected";
		MCU_TE[6].TEname="";
    }
    Else
    {
    	XT_TE_Name$[6]="--";
    }
    
    
    
    If (MCU_TE[7].Conn=kCONN)
    {
    	If(len(MCU_TE[7].TEname))
    	{
    		XT_TE_Name$[7]=MCU_TE[7].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[7]=" ";
    	}
    }
    Else If (MCU_TE[7].Conn=kDISC)
    {
    	XT_TE_Name$[7]="Disconnected";
		MCU_TE[7].TEname="";
    }
    Else
    {
    	XT_TE_Name$[7]="--";
    }
    
    
    
    If (MCU_TE[8].Conn=kCONN)
    {
    	If(len(MCU_TE[8].TEname))
    	{
    		XT_TE_Name$[8]=MCU_TE[8].TEname;
    	}
    	Else
    	{
    		XT_TE_Name$[8]=" ";
    	}
    }
    Else If (MCU_TE[8].Conn=kDISC)
    {
    	XT_TE_Name$[8]="Disconnected";
		MCU_TE[8].TEname="";
    }
    Else
    {
    	XT_TE_Name$[8]="--";
