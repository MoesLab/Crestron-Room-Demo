	iLocalRequest = 0;
	for(i = 1 to 25)
	{
		LocalEntryValid[i] = 0;
	}
	GlobalSiteRequested = 0;
	iGlobalRequest = 0;
	for(i = 1 to 25)
	{
		GlobalEntryValid[i] = 0;
	}
	iFlag2 = 0;
	clearbuffer(sHeader);
	clearbuffer(sFooter);
	clearbuffer(sSeparater);
	clearbuffer(sNum1);
	clearbuffer(sNum2);
	num_1_fb$ = sNum1;
	num_2_fb$ = sNum2;
	text_fb$ = "";
	iIncomingText = ciENTERINGNUM1;
	iAddrbkBusy = 0;
	Local_Addressbook_Busy = iAddrbkBusy;
	iGAddrbkBusy = 0;
	Global_Addressbook_Busy = iGAddrbkBusy;
	iAddrGroupSize = ciDEFAULTGROUPS;
	iCurrentLocalLevel = 100;
	iCurrentGlobalLevel = 100;
	nextSearchChar = ciCHARARRAYSIZE + 1;
	PopulateCharArray();
}
