STRUCTURE MyTerm
{
	Integer Conn;//0=disc 1=connected 99=undefined
	Integer MuteAudio;//0=disc 1=connected 2=muted
	Integer VideoBrdc;//0=disc 1=connected 2=active_spk 3=Prev._spk 4=Chairman_Broadcast 
	String TEname[30];
	
};

MyTerm MCU_TE[MAX_TE];



